+/* diagnostic build: spin loops call these millions of times */
+static BOOL is_noisy_syscall( const char *name )
+{
+    return name && (!strcmp( name, "NtQueryPerformanceCounter" ) || !strcmp( name, "NtYieldExecution" )
+                    || !strcmp( name, "NtQuerySystemTime" ));
+}
