diff -ruN a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
--- a/dlls/ntdll/unix/signal_x86_64.c	2026-10-07 16:08:29.141424158 +0900
+++ b/dlls/ntdll/unix/signal_x86_64.c	2026-10-07 16:08:51.860856049 +0900
@@ -2944,6 +2944,28 @@
  *
  * Handler for SIGUSR1, used to signal a thread that it got suspended.
  */
+/* diagnostic build: print the user-mode return addresses of the current syscall */
+void dbg_dump_user_stack( const char *tag )
+{
+    struct syscall_frame *frame = get_syscall_frame();
+    const ULONG64 *sp = (const ULONG64 *)frame->rsp;
+    unsigned int i, n = 0;
+    char buf[1024];
+    int len = snprintf( buf, sizeof(buf), "rip %#lx", (unsigned long)frame->rip );
+
+    for (i = 0; i < 256 && n < 24 && len < (int)sizeof(buf) - 24; i++)
+    {
+        ULONG64 v;
+        if (!virtual_check_buffer_for_read( sp + i, sizeof(*sp) )) break;
+        v = sp[i];
+        if (v < 0x10000 || v >= 0x800000000000ull) continue;
+        if (!virtual_is_valid_code_address( (const void *)v, 1 )) continue;
+        len += snprintf( buf + len, sizeof(buf) - len, " %#lx", (unsigned long)v );
+        n++;
+    }
+    ERR( "%s %s\n", tag, buf );
+}
+
 static void usr1_handler( int signal, siginfo_t *siginfo, void *sigcontext )
 {
     ucontext_t *ucontext = init_handler( sigcontext );
