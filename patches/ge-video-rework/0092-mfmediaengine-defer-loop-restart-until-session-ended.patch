From: GloriousEggroll <gloriouseggroll@gmail.com>
Subject: [PATCH] mfmediaengine: Defer loop restarts until the session has ended.

Crimson Desert can stall at the title menu after titleview_03.mp4 reaches
EOF. Its media engine has looping enabled when MEEndOfPresentation arrives.
The handler immediately seeks back to zero, which resets the video sink's
sample queue before submitting the replay to the media session.

Patch 0059 correctly serializes replay against the old presentation's
draining. Resetting the sink before that drain completes can discard the
samples needed to request the remaining decoder output and end marker,
leaving both the drain and the queued replay waiting indefinitely.

In the failing trace, the replay is submitted at 156.587 but never reaches
session_commands_callback_Invoke. The game disables looping at 156.826,
then polls OnVideoStreamTick without receiving another frame for the rest
of the capture.

Do not restart loops on the source-level MEEndOfPresentation event. Keep
draining and let MESessionEnded perform the loop seek instead. If the
application disables looping meanwhile, that handler reports normal
completion. Preserve the early ended notification for non-looping sources,
which existing media-engine clients rely on, and keep session serialization.

Add coverage for two video-loop restarts followed by disabling looping and
waiting for normal completion.

References:
 https://learn.microsoft.com/en-us/windows/win32/medfound/meendofpresentation
 https://learn.microsoft.com/en-us/windows/win32/medfound/mesessionended
---

diff --git a/dlls/mfmediaengine/main.c b/dlls/mfmediaengine/main.c
--- a/dlls/mfmediaengine/main.c
+++ b/dlls/mfmediaengine/main.c
@@ -1170,7 +1170,10 @@ static HRESULT WINAPI media_engine_session_events_Invoke(IMFAsyncCallback *iface, IMFAsyncResult *result)
             /* Media Engine users may wait on ended state before replacing the
              * source. Network streams can deliver source end-of-presentation
              * before every renderer has drained enough to produce MESessionEnded. */
-            ended_event = media_engine_handle_ended(engine);
+            /* Loop seeks reset the sink's sample queue. Wait for MESessionEnded
+             * before doing that, otherwise the queued replay can wait forever
+             * for the samples and end-of-segment marker we still need to drain. */
+            ended_event = !(engine->flags & FLAGS_ENGINE_LOOP) && media_engine_handle_ended(engine);
             LeaveCriticalSection(&engine->cs);
             if (ended_event)
                 IMFMediaEngineNotify_EventNotify(engine->callback, MF_MEDIA_ENGINE_EVENT_ENDED, 0, 0);

diff --git a/dlls/mfmediaengine/tests/mfmediaengine.c b/dlls/mfmediaengine/tests/mfmediaengine.c
index 0b815c7b8ed..ad32cfdf534 100644
--- a/dlls/mfmediaengine/tests/mfmediaengine.c
+++ b/dlls/mfmediaengine/tests/mfmediaengine.c
@@ -2979,6 +2979,78 @@ done:
     IMFByteStream_Release(stream);
 }
 
+static void test_looped_playback(void)
+{
+    struct test_seek_notify *notify = create_seek_notify();
+    IMFMediaEngineEx *media_engine = NULL;
+    IMFByteStream *stream = NULL;
+    LONGLONG pts, last_pts = -1;
+    unsigned int loops = 0;
+    DWORD start, res;
+    HRESULT hr;
+    BSTR url = NULL;
+
+    hr = create_media_engine(&notify->IMFMediaEngineNotify_iface, NULL, FALSE, DXGI_FORMAT_B8G8R8X8_UNORM,
+            &IID_IMFMediaEngineEx, (void **)&media_engine);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+
+    stream = load_resource(L"i420-64x64.avi", L"video/avi");
+    url = SysAllocString(L"i420-64x64.avi");
+    hr = IMFMediaEngineEx_SetLoop(media_engine, TRUE);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IMFMediaEngineEx_SetSourceFromByteStream(media_engine, stream, url);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+
+    hr = IMFMediaEngineEx_Play(media_engine);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    res = WaitForSingleObject(notify->playing_event, 5000);
+    ok(res == WAIT_OBJECT_0, "Waiting for playback returned %#lx.\n", res);
+    if (res != WAIT_OBJECT_0 || FAILED(notify->error)) goto done;
+
+    /* Consuming the final samples must allow replay to start after the sink drains. */
+    start = GetTickCount();
+    while (loops < 2 && GetTickCount() - start < 5000)
+    {
+        hr = IMFMediaEngineEx_OnVideoStreamTick(media_engine, &pts);
+        ok(hr == S_OK || hr == S_FALSE, "Unexpected tick hr %#lx.\n", hr);
+        if (FAILED(hr)) break;
+        if (hr == S_OK)
+        {
+            if (last_pts >= 0 && pts < last_pts) ++loops;
+            last_pts = pts;
+        }
+        Sleep(1);
+    }
+    ok(loops == 2, "Video did not restart twice, observed %u loops.\n", loops);
+    ok(!IMFMediaEngineEx_IsEnded(media_engine), "Looping playback reported ended.\n");
+
+    /* Turning looping off must let the current iteration complete normally. */
+    hr = IMFMediaEngineEx_SetLoop(media_engine, FALSE);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    start = GetTickCount();
+    while (!IMFMediaEngineEx_IsEnded(media_engine) && GetTickCount() - start < 5000)
+    {
+        hr = IMFMediaEngineEx_OnVideoStreamTick(media_engine, &pts);
+        ok(hr == S_OK || hr == S_FALSE, "Unexpected tick hr %#lx.\n", hr);
+        if (FAILED(hr)) break;
+        Sleep(1);
+    }
+    ok(IMFMediaEngineEx_IsEnded(media_engine), "Playback did not end after disabling looping.\n");
+
+done:
+    if (media_engine)
+    {
+        hr = IMFMediaEngineEx_Shutdown(media_engine);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        IMFMediaEngineEx_Release(media_engine);
+    }
+    if (stream) IMFByteStream_Release(stream);
+    SysFreeString(url);
+    IMFMediaEngineNotify_Release(&notify->IMFMediaEngineNotify_iface);
+}
+
 START_TEST(mfmediaengine)
 {
     HRESULT hr;
@@ -3027,6 +3099,7 @@ START_TEST(mfmediaengine)
     test_GetSeekable(TRUE);
     test_media_extension();
     test_SetCurrentTime();
+    test_looped_playback();
 
     IMFMediaEngineClassFactory_Release(factory);
 
