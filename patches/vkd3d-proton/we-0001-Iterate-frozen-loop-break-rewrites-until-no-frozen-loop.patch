From 0d5c232f1363ffb829a4ffead4d88232b4c88fa3 Mon Sep 17 00:00:00 2001
From: shorinkiwata <fcl709@outlook.com>
Date: Thu, 22 Oct 2026 02:22:34 +0900
Subject: [PATCH] Iterate frozen loop break rewrites until no frozen loop is
 left broken.

rewrite_invalid_frozen_loop_breaks() moves blocks that escape a frozen
loop behind dispatch blocks after the loop merge, then structurize(1)
runs once more. That pass can promote one of the new dispatch blocks to
a frozen loop itself (fixup_broken_selection_merges()), and nothing
checks the breaks of that loop, so the output can contain a loop that
is exited through a block other than its merge:

  block 'X' exits the loop headed by 'Y', but not via a structured exit

Repeat the rewrite and structurize(1) until no rewrite is needed.

Seen in a pixel shader from a game, where RADV then crashed on the NULL
NIR returned by spirv_to_nir. The CFG reduces to:

  b entry n31
  c n31 n38 n100
  c n38 n43 n39
  c n43 n46 n44
  sideeffect n46
  b n46 n100
  sideeffect n44
  b n44 n100
  c n39 n57 n48
  c n57 n46 n100
  c n48 n77 n86
  b n77 n100
  c n86 n46 n82
  sideeffect n82
  b n82 n100

No change in output for any shader in the test suite.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 cfg_structurizer.cpp | 35 +++++++++++++++++++++++------------
 1 file changed, 23 insertions(+), 12 deletions(-)

diff --git a/subprojects/dxil-spirv/cfg_structurizer.cpp b/subprojects/dxil-spirv/cfg_structurizer.cpp
index 7fcea7b7..4287d36d 100644
--- a/subprojects/dxil-spirv/cfg_structurizer.cpp
+++ b/subprojects/dxil-spirv/cfg_structurizer.cpp
@@ -1558,24 +1558,32 @@ bool CFGStructurizer::run()
 	}
 #endif
 
-	bool need_restructure = false;
+	bool need_restructure;
 
-	while (rewrite_invalid_frozen_loop_breaks())
+	// Redoing the final structurization pass can promote a selection to a frozen loop again
+	// (fixup_broken_selection_merges()), typically one of the dispatch blocks we just created.
+	// That loop needs the same fixup, so iterate until nothing breaks out of a frozen loop.
+	for (unsigned iteration = 0; iteration < 16; iteration++)
 	{
-#ifdef DXIL_SPIRV_DEBUG_DUMPING
-		if (!graphviz_path.empty())
+		need_restructure = false;
+
+		while (rewrite_invalid_frozen_loop_breaks())
 		{
-			auto graphviz_final = graphviz_path + ".loop-break-rewrite";
-			log_cfg_graphviz(graphviz_final.c_str());
-		}
+#ifdef DXIL_SPIRV_DEBUG_DUMPING
+			if (!graphviz_path.empty())
+			{
+				auto graphviz_final = graphviz_path + ".loop-break-rewrite";
+				log_cfg_graphviz(graphviz_final.c_str());
+			}
 #endif
 
-		need_restructure = true;
-	}
+			need_restructure = true;
+		}
 
-	// Defer recomputing the structurization.
-	if (need_restructure)
-	{
+		if (!need_restructure)
+			break;
+
+		// Defer recomputing the structurization.
 		structurize(1);
 
 #ifdef DXIL_SPIRV_DEBUG_DUMPING
@@ -1587,6 +1595,9 @@ bool CFGStructurizer::run()
 #endif
 	}
 
+	if (need_restructure)
+		LOGW("Frozen loop break rewrites did not converge.\n");
+
 	while (rewrite_invalid_real_loop_breaks())
 	{
 		// This completely nukes the structurization, need to redo it.
