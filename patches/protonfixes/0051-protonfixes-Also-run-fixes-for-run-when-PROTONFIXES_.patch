From ab4c5adf925eddc37fe86407218becf65cdd1680 Mon Sep 17 00:00:00 2001
From: shorinkiwata <fcl709@outlook.com>
Date: Mon, 12 Oct 2026 04:32:09 +0900
Subject: [PATCH] protonfixes: Also run fixes for "run" when
 PROTONFIXES_RUN_VERB=1.

Fixes run only when the verb is "waitforexitandrun", which first waits
for the prefix's wineserver to exit. A launcher that starts a program
into a prefix whose wineserver is still running uses "run" instead, and
the program then gets none of its fixes. PROTONFIXES_RUN_VERB=1 lets
such a launcher ask for them; PROTONFIXES_DISABLE still turns them off.
It stays opt-in because "run" also starts helper programs that are not
the game, such as a driver query.

Also require two arguments before reading the verb from sys.argv[1].

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 __init__.py | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/__init__.py b/__init__.py
index ad1db3e..13a34aa 100644
--- a/__init__.py
+++ b/__init__.py
@@ -38,15 +38,22 @@ aarch64_lib_dir: str = (
 def check_conditions() -> bool:
     """Determine, if the actual game was executed and protonfixes isn't deactivated.
 
+    Games are started with "waitforexitandrun", which first waits for the
+    prefix's wineserver to exit. "run" starts a program while the wineserver
+    keeps running; PROTONFIXES_RUN_VERB=1 asks for the program's fixes there too.
+
     Returns:
         bool: True, if the fix should be executed.
 
     """
     return (
-        len(sys.argv) >= 1
+        len(sys.argv) >= 2
         and 'STEAM_COMPAT_DATA_PATH' in os.environ
         and 'PROTONFIXES_DISABLE' not in os.environ
-        and 'waitforexitandrun' in sys.argv[1]
+        and (
+            'waitforexitandrun' in sys.argv[1]
+            or (sys.argv[1] == 'run' and os.environ.get('PROTONFIXES_RUN_VERB') == '1')
+        )
     )
 
 
