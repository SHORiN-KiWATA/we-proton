From c18deebc9e0d8c3086d893c84c8bb474557a6797 Mon Sep 17 00:00:00 2001
From: shxrrydw <sherrydrv@gmail.com>
Date: Thu, 6 Aug 2026 17:53:39 +0200
Subject: [PATCH] server: Drop the kernel modules of a process that exits.

App: Hololive Dreams (4282500).
---
 server/device.c  | 16 ++++++++++++++++
 server/object.h  |  2 ++
 server/process.c |  1 +
 3 files changed, 19 insertions(+)

diff --git a/server/device.c b/server/device.c
index 79938845aad..25cd107b234 100644
--- a/server/device.c
+++ b/server/device.c
@@ -905,6 +905,22 @@ void free_kernel_objects( struct object *obj )
 }
 
 
+/* remove the modules of a process that is going away, a winedevice may
+ * die without unloading its drivers */
+void free_kernel_modules( struct process *process )
+{
+    struct kernel_module *module, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( module, next, &kernel_modules, struct kernel_module, entry )
+    {
+        if (module->owner != process) continue;
+        list_remove( &module->entry );
+        free( module->name );
+        free( module );
+    }
+}
+
+
 /* create a device manager */
 DECL_HANDLER(create_device_manager)
 {
diff --git a/server/object.h b/server/object.h
index 21f5ea88bd3..7f03289d5d4 100644
--- a/server/object.h
+++ b/server/object.h
@@ -161,6 +161,8 @@ extern void *open_named_object( struct object *parent, const struct object_ops *
 extern void unlink_named_object( struct object *obj );
 extern struct namespace *create_namespace( unsigned int hash_size );
 extern void free_kernel_objects( struct object *obj );
+extern void free_kernel_modules( struct process *process );
+extern void unregister_process_kernel_modules( struct process *process );
 /* grab/release_object can take any pointer, but you better make sure */
 /* that the thing pointed to starts with a struct object... */
 extern struct object *grab_object( void *obj );
diff --git a/server/process.c b/server/process.c
index 8fe64305e02..d161cbf8693 100644
--- a/server/process.c
+++ b/server/process.c
@@ -812,6 +812,7 @@ static void process_destroy( struct object *obj )
 
     close_process_handles( process );
     set_process_startup_state( process, STARTUP_ABORTED );
+    free_kernel_modules( process );
 
     if (process->job)
     {
