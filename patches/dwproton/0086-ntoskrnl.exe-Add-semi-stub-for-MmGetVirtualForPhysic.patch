From: Etaash Mathamsetty <etaash.mathamsetty@gmail.com>
Date: Tue, 22 Jul 2025 21:34:12 -0400
Subject: [PATCH] ntoskrnl.exe: Add semi-stub for MmGetVirtualForPhysical.

(cherry picked from commit 4f3fabea9d117100d06a7d2e7fbbc93a7f5eaa85)
---
 dlls/ntoskrnl.exe/ntoskrnl.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
index 124fe2ce966..7dc8cb99af6 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -3185,6 +3185,16 @@ void *WINAPI MmGetVirtualForPhysical(PHYSICAL_ADDRESS addr)
     return (void *)ret;
 }
 
+/***********************************************************************
+ *           MmGetVirtualForPhysical   (NTOSKRNL.EXE.@)
+ */
+void *WINAPI MmGetVirtualForPhysical(PHYSICAL_ADDRESS addr)
+{
+    ULONG_PTR ret = addr.QuadPart;
+    FIXME("(%s): semi-stub\n", wine_dbgstr_longlong(addr.QuadPart));
+    return (void *)ret;
+}
+
 /***********************************************************************
  *           MmMapIoSpace   (NTOSKRNL.EXE.@)
  */
