From 2717c340afc8b6f928a337a5c0be3b85c7f63341 Mon Sep 17 00:00:00 2001
From: Ziia Shi <mkrsym1@gmail.com>
Date: Thu, 6 Aug 2026 22:19:18 +0200
Subject: [PATCH] wdf01000.sys: Populate index 201 in the FuncTable.

App: Neverness to Everness (4508340).
---
 dlls/wdf01000.sys/main.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/dlls/wdf01000.sys/main.c b/dlls/wdf01000.sys/main.c
index 54ba347aaac..f943f2315ee 100644
--- a/dlls/wdf01000.sys/main.c
+++ b/dlls/wdf01000.sys/main.c
@@ -122,6 +122,12 @@ static WDF_LIBRARY_INFO kmdf_wdf_library_info = {
     { 1, 0, 0 }
 };
 
+/* stub for WdfDriverMiniportUnload (idx 201) */
+static void WINAPI wdf_stub_void_noop(void *arg)
+{
+    TRACE("stub called with %p\n", arg);
+}
+
 NTSTATUS WINAPI DriverEntry(DRIVER_OBJECT *driver, UNICODE_STRING *path)
 {
     NTSTATUS status;
@@ -131,6 +137,9 @@ NTSTATUS WINAPI DriverEntry(DRIVER_OBJECT *driver, UNICODE_STRING *path)
     kmdf_globals.DriverObject = driver;
     kmdf_globals.RegistryPath = path;
 
+    /* populate index 201 (WdfDriverMiniportUnload) */
+    kmdf_functable[201] = wdf_stub_void_noop;
+
     status = WdfRegisterLibrary(&kmdf_wdf_library_info, path, NULL);
 
     return status;
