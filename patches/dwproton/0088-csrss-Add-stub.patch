From: shxrrydw <sherrydrv@gmail.com>
Date: Thu, 6 Aug 2026 12:58:38 +0200
Subject: [PATCH] csrss: Add stub.

---
 configure.ac               |  1 +
 loader/wine.inf.in         |  2 ++
 programs/csrss/Makefile.in |  6 ++++++
 programs/csrss/main.c      | 32 ++++++++++++++++++++++++++++++++
 4 files changed, 41 insertions(+)
 create mode 100644 programs/csrss/Makefile.in
 create mode 100644 programs/csrss/main.c

diff --git a/configure.ac b/configure.ac
index 1aad8a4de29..8875f698de3 100644
--- a/configure.ac
+++ b/configure.ac
@@ -3616,6 +3616,7 @@ WINE_CONFIG_MAKEFILE(programs/certutil)
 WINE_CONFIG_MAKEFILE(programs/chcp.com)
 WINE_CONFIG_MAKEFILE(programs/clock)
 WINE_CONFIG_MAKEFILE(programs/cmd)
+WINE_CONFIG_MAKEFILE(programs/csrss)
 WINE_CONFIG_MAKEFILE(programs/cmd/tests)
 WINE_CONFIG_MAKEFILE(programs/conhost)
 WINE_CONFIG_MAKEFILE(programs/conhost/tests)
diff --git a/loader/wine.inf.in b/loader/wine.inf.in
index 36881d376b4..e2494e25ebd 100644
--- a/loader/wine.inf.in
+++ b/loader/wine.inf.in
@@ -1085,6 +1085,8 @@ HKLM,SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x86,"Version",2,"14.42.344
 11,,presentationfontcache.exe,-
 ; some programs are 64-bit only
 11,,conhost.exe,-
+11,,csrss.exe,-
+11,,lsass.exe,-
 11,,plugplay.exe,-
 11,,rpcss.exe,-
 11,,services.exe,-
diff --git a/programs/csrss/Makefile.in b/programs/csrss/Makefile.in
new file mode 100644
index 00000000000..35344219728
--- /dev/null
+++ b/programs/csrss/Makefile.in
@@ -0,0 +1,6 @@
+MODULE    = csrss.exe
+
+EXTRADLLFLAGS = -mwindows
+
+SOURCES = \
+	main.c
diff --git a/programs/csrss/main.c b/programs/csrss/main.c
new file mode 100644
index 00000000000..0ddffda250c
--- /dev/null
+++ b/programs/csrss/main.c
