From a6d460d28255b7983ce0efdd9b24d564ae2b8812 Mon Sep 17 00:00:00 2001
From: Conor McCarthy <cmccarthy@codeweavers.com>
Date: Mon, 7 Sep 2026 16:36:28 +1000
Subject: [PATCH] mf/evr: Always send MEStreamSinkStopped in OnClockStop().

(cherry picked from commit 791fc577bb00dbb43f86581ba6687cd361f7846b)
---
 dlls/mf/evr.c      | 7 ++++++-
 dlls/mf/tests/mf.c | 2 --
 2 files changed, 6 insertions(+), 3 deletions(-)

diff --git a/dlls/mf/evr.c b/dlls/mf/evr.c
index 3beddfe5416..c1e83c327ba 100644
--- a/dlls/mf/evr.c
+++ b/dlls/mf/evr.c
@@ -2062,7 +2062,6 @@ static HRESULT WINAPI video_renderer_clock_sink_OnClockStop(IMFClockStateSink *i
         for (i = 0; i < renderer->stream_count; ++i)
         {
             struct video_stream *stream = renderer->streams[i];
-            IMFMediaEventQueue_QueueEventParamVar(stream->event_queue, MEStreamSinkStopped, &GUID_NULL, S_OK, NULL);
 
             EnterCriticalSection(&stream->cs);
             stream->flags &= ~(EVR_STREAM_PREROLLED | EVR_STREAM_SAMPLE_NEEDED);
@@ -2071,6 +2070,12 @@ static HRESULT WINAPI video_renderer_clock_sink_OnClockStop(IMFClockStateSink *i
         renderer->state = EVR_STATE_STOPPED;
     }
 
+    for (i = 0; i < renderer->stream_count; ++i)
+    {
+        struct video_stream *stream = renderer->streams[i];
+        IMFMediaEventQueue_QueueEventParamVar(stream->event_queue, MEStreamSinkStopped, &GUID_NULL, S_OK, NULL);
+    }
+
     LeaveCriticalSection(&renderer->cs);
 
     return S_OK;
diff --git a/dlls/mf/tests/mf.c b/dlls/mf/tests/mf.c
index de3ac8ac336..dea60fcfd2a 100644
--- a/dlls/mf/tests/mf.c
+++ b/dlls/mf/tests/mf.c
@@ -5601,7 +5601,6 @@ static void test_evr(void)
     ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
     PropVariantInit(&propvar);
     hr = gen_wait_media_event_until_blocking((IMFMediaEventGenerator *)stream_sink, callback, MEStreamSinkStopped, 1000, &propvar);
-    todo_wine
     ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
     PropVariantClear(&propvar);
 
@@ -5622,7 +5621,6 @@ static void test_evr(void)
     hr = IMFClockStateSink_OnClockStop(state_sink, 0);
     ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
     hr = gen_wait_media_event_until_blocking((IMFMediaEventGenerator *)stream_sink, callback, MEStreamSinkStopped, 1000, &propvar);
-    todo_wine
     ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
     PropVariantClear(&propvar);
 
