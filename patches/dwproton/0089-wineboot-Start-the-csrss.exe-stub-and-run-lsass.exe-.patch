From 64c167a2ab49685da6cb963e7d3cec74be22ce7a Mon Sep 17 00:00:00 2001
From: shxrrydw <sherrydrv@gmail.com>
Date: Thu, 6 Aug 2026 13:28:38 +0200
Subject: [PATCH] wineboot: Start the csrss.exe stub, and run lsass.exe in
 session 0.

App: Hololive Dreams (4282500).
---
 programs/lsass/main.c        |  4 ++++
 programs/wineboot/wineboot.c | 15 +++++++++++++++
 2 files changed, 19 insertions(+)

diff --git a/programs/lsass/main.c b/programs/lsass/main.c
index d2e1094c006..51be73a72dc 100644
--- a/programs/lsass/main.c
+++ b/programs/lsass/main.c
@@ -20,6 +20,7 @@
 #include <stdarg.h>
 
 #include "windows.h"
+#include "winternl.h"
 #include "winsvc.h"
 
 #include "wine/debug.h"
@@ -94,7 +95,10 @@ int __cdecl wmain( int argc, WCHAR *argv[] )
         { samssW, ServiceMain },
         { NULL, NULL }
     };
+    ULONG session_id = 0;
 
+    NtSetInformationProcess( GetCurrentProcess(), ProcessWineSessionId,
+                             &session_id, sizeof(session_id) );
     StartServiceCtrlDispatcherW( service_table );
     return 0;
 }
diff --git a/programs/wineboot/wineboot.c b/programs/wineboot/wineboot.c
index f49fccf6894..00f6baeaa8b 100644
--- a/programs/wineboot/wineboot.c
+++ b/programs/wineboot/wineboot.c
@@ -1455,6 +1455,20 @@ static int ProcessWindowsFileProtection(void)
     return 1;
 }
 
+static void start_stub_process(const WCHAR *path)
+{
+    PROCESS_INFORMATION pi;
+    STARTUPINFOW si = { sizeof(si) };
+
+    if (!CreateProcessW(path, NULL, NULL, NULL, FALSE, DETACHED_PROCESS, NULL, NULL, &si, &pi))
+    {
+        WINE_ERR("Couldn't start %s: error %lu\n", wine_dbgstr_w(path), GetLastError());
+        return;
+    }
+    CloseHandle(pi.hThread);
+    CloseHandle(pi.hProcess);
+}
+
 static BOOL start_services_process(void)
 {
     static const WCHAR svcctl_started_event[] = SVCCTL_STARTED_EVENT;
@@ -2026,6 +2040,7 @@ int __cdecl main( int argc, char *argv[] )
     {
         ProcessRunKeys( HKEY_LOCAL_MACHINE, L"RunServices", FALSE, FALSE );
         start_services_process();
+        start_stub_process( L"C:\\windows\\system32\\csrss.exe" );
     }
     if (init || update) update_wineprefix( update );
 
