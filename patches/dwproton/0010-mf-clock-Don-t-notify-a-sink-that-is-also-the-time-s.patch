From 289a722880dae4bc12fb6b4693d19a8577d065af Mon Sep 17 00:00:00 2001
From: Conor McCarthy <cmccarthy@codeweavers.com>
Date: Mon, 7 Sep 2026 16:15:15 +1000
Subject: [PATCH] mf/clock: Don't notify a sink that is also the time source in
 AddClockStateSink().

(cherry picked from commit 601c15ae64623967725dab71f0095f14ec91293a)
---
 dlls/mf/clock.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/dlls/mf/clock.c b/dlls/mf/clock.c
index 61467bef175..4027d1683df 100644
--- a/dlls/mf/clock.c
+++ b/dlls/mf/clock.c
@@ -501,7 +501,9 @@ static HRESULT WINAPI present_clock_AddClockStateSink(IMFPresentationClock *ifac
         };
         struct clock_state_change_param param;
 
-        if (!clock->is_shut_down && clock->state != MFCLOCK_STATE_INVALID)
+        if (!clock->is_shut_down && clock->state != MFCLOCK_STATE_INVALID
+                /* Don't notify a sink that is also the time source */
+                && clock->time_source_sink != sink->state_sink)
         {
             param.u.offset = clock->start_offset;
             clock_notify_async_sink(clock, MFGetSystemTime(), param, notifications[clock->state], sink->state_sink);
