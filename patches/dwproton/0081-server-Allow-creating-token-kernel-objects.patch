From 477a2f42136f0e60944153cfd20755cd266e0463 Mon Sep 17 00:00:00 2001
From: Nello De Gregoris <bluechxindv@gmail.com>
Date: Thu, 10 Sep 2026 04:28:39 +0200
Subject: [PATCH] server: Allow creating token kernel objects.

(cherry picked from commit 44ae05436ab58a5d6946676c0fed21f6df2bcae7)
---
 server/token.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/server/token.c b/server/token.c
index 6181d2f775a..c281429288d 100644
--- a/server/token.c
+++ b/server/token.c
@@ -121,6 +121,7 @@ struct token
     struct acl    *default_dacl;    /* the default DACL to assign to objects created by this user */
     int            impersonation_level; /* impersonation level this token is capable of if non-primary token */
     int            elevation;       /* elevation type */
+    struct list    kernel_object;   /* list of kernel object pointers */
 };
 
 struct privilege
@@ -143,6 +144,7 @@ static void token_destroy( struct object *obj );
 static struct list *token_get_kernel_obj_list( struct object *obj );
 static int token_set_sd( struct object *obj, const struct security_descriptor *sd,
                          unsigned int set_info );
+static struct list *token_get_kernel_obj_list( struct object *obj );
 
 static const struct object_ops token_ops =
 {
@@ -189,6 +191,12 @@ static int token_set_sd( struct object *obj, const struct security_descriptor *s
     return default_set_sd( obj, sd, set_info & ~LABEL_SECURITY_INFORMATION );
 }
 
+static struct list *token_get_kernel_obj_list( struct object *obj )
+{
+    struct token *token = (struct token *)obj;
+    return &token->kernel_object;
+}
+
 void security_set_thread_token( struct thread *thread, obj_handle_t handle )
 {
     if (!handle)
