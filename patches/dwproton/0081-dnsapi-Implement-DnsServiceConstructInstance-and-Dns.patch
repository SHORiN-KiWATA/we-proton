+    IP4_ADDRESS *ip4Address;
+    IP6_ADDRESS *ip6Address;
+    WORD wPort;
+    WORD wPriority;
+    WORD wWeight;
+    DWORD dwPropertyCount;
+    PWSTR *keys;
+    PWSTR *values;
+    DWORD dwInterfaceIndex;
