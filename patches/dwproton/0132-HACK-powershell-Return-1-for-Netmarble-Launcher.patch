From 9f4a9368c0c56cc33daf6a501a39183c9715d4c9 Mon Sep 17 00:00:00 2001
From: shxrrydw <sherrydrv@gmail.com>
Date: Mon, 27 Jul 2026 14:09:01 +0200
Subject: [PATCH] HACK: powershell: Return 1 for Netmarble Launcher.

App: Netmarble Launcher.
---
 programs/powershell/main.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/programs/powershell/main.c b/programs/powershell/main.c
index 25a4d13d340..4290c0ff7f7 100644
--- a/programs/powershell/main.c
+++ b/programs/powershell/main.c
@@ -44,5 +44,13 @@ int __cdecl wmain(int argc, WCHAR *argv[])
             }
         }
     }
+
+    /* HACK: Netmarble Launcher installer uses powershell to check if it's already running */
+    if (argc > 2 && wcsstr(argv[2], L"Netmarble Launcher"))
+    {
+        WINE_FIXME("HACK: returning 1 for Netmarble Launcher.\n");
+        return 1;
+    }
+
     return 0;
 }
