diff --git a/programs/csrss/Makefile.in b/programs/csrss/Makefile.in
new file mode 100644
index 00000000000..35344219728
--- /dev/null
+++ b/programs/csrss/Makefile.in
@@ -0,0 +1,6 @@
+MODULE    = csrss.exe
+
+EXTRADLLFLAGS = -mwindows
+
+SOURCES = \
+	main.c
diff --git a/programs/csrss/main.c b/programs/csrss/main.c
new file mode 100644
index 00000000000..0ddffda250c
--- /dev/null
+++ b/programs/csrss/main.c
@@ -0,0 +1,32 @@
