index d0575652c48..9ec9f0b3460 100644
--- a/loader/wine.inf.in
+++ b/loader/wine.inf.in
@@ -1081,6 +1081,8 @@ HKLM,SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x86,"Version",2,"14.42.344
 11,,presentationfontcache.exe,-
 ; some programs are 64-bit only
