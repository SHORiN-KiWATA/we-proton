From 5fe8c9d16a5a50638ec4b53d922a56d35c2a0a43 Mon Sep 17 00:00:00 2001
From: Nello De Gregoris <bluechxindv@gmail.com>
Date: Wed, 23 Sep 2026 11:54:12 +0200
Subject: [PATCH] rsaenh: Check the HMAC hash algorithm in CPSetHashParam().

(cherry picked from commit 1b0c0e3b41f495d498a6c515bc1d809d35d70adf)

CW-Bug-Id: #27698
---
 dlls/rsaenh/rsaenh.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/dlls/rsaenh/rsaenh.c b/dlls/rsaenh/rsaenh.c
index b9b4ed37274..3cfce34c05c 100644
--- a/dlls/rsaenh/rsaenh.c
+++ b/dlls/rsaenh/rsaenh.c
@@ -4747,6 +4747,7 @@ BOOL WINAPI RSAENH_CPSetHashParam(HCRYPTPROV hProv, HCRYPTHASH hHash, DWORD dwPa
 {
     CRYPTHASH *pCryptHash;
     CRYPTKEY *pCryptKey;
+    struct hash inner;
     DWORD i;
 
     TRACE("(hProv=%08Ix, hHash=%08Ix, dwParam=%08lx, pbData=%p, dwFlags=%08lx)\n",
@@ -4772,6 +4773,13 @@ BOOL WINAPI RSAENH_CPSetHashParam(HCRYPTPROV hProv, HCRYPTHASH hHash, DWORD dwPa
     
     switch (dwParam) {
         case HP_HMAC_INFO:
+            init_hash_impl(((const HMAC_INFO *)pbData)->HashAlgid, &inner);
+            if (!inner.desc)
+            {
+                SetLastError(NTE_BAD_ALGID);
+                return FALSE;
+            }
+
             free_hmac_info(pCryptHash->pHMACInfo);
             if (!copy_hmac_info(&pCryptHash->pHMACInfo, (PHMAC_INFO)pbData)) return FALSE;
 
