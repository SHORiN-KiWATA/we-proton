From 150986a1d741aecd774bfaf01d984e402e8a5534 Mon Sep 17 00:00:00 2001
From: Michel Weinachter <michel@weinachter.com>
Date: Tue, 1 Sep 2026 11:03:42 +0200
Subject: [PATCH] ntoskrnl.exe/tests: Test the MDL flags maintained by
 test_mdl_map().

MmProbeAndLockPages(), MmUnmapLockedPages() and MmUnlockPages() return
nothing, so the only thing a test can observe about them is the state they
leave in the descriptor.

Values observed on Windows 8.1 32-bit (WineHQ TestBot, w8), starting from
the MDL_ALLOCATED_FIXED_SIZE that IoAllocateMdl() leaves behind:

  IoAllocateMdl()                 0x0008
  MmProbeAndLockPages()           0x000a  + MDL_PAGES_LOCKED
  MmMapLockedPages()              0x000b  + MDL_MAPPED_TO_SYSTEM_VA
  MmUnmapLockedPages()            0x000a  - MDL_MAPPED_TO_SYSTEM_VA
  MmMapLockedPagesSpecifyCache()  0x000b  + MDL_MAPPED_TO_SYSTEM_VA
  MmUnmapLockedPages()            0x000a  - MDL_MAPPED_TO_SYSTEM_VA
  MmUnlockPages()                 0x0008  - MDL_PAGES_LOCKED

The individual bits are tested rather than the whole word, since
MDL_ALLOCATED_FIXED_SIZE is an allocation detail of IoAllocateMdl().

(cherry picked from commit c58020f27c23b67c3eb363c7e6d734535429e0c6)
---
 dlls/ntoskrnl.exe/tests/driver.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/dlls/ntoskrnl.exe/tests/driver.c b/dlls/ntoskrnl.exe/tests/driver.c
index f793800e4f0..1850c881a4f 100644
--- a/dlls/ntoskrnl.exe/tests/driver.c
+++ b/dlls/ntoskrnl.exe/tests/driver.c
@@ -285,24 +285,35 @@ static void test_mdl_map(void)
 
     mdl = IoAllocateMdl(buffer, sizeof(buffer), FALSE, FALSE, NULL);
     ok(mdl != NULL, "IoAllocateMdl failed\n");
+    ok(!(mdl->MdlFlags & MDL_PAGES_LOCKED), "got flags %#x\n", mdl->MdlFlags);
+    ok(!(mdl->MdlFlags & MDL_MAPPED_TO_SYSTEM_VA), "got flags %#x\n", mdl->MdlFlags);
 
     MmProbeAndLockPages(mdl, KernelMode, IoReadAccess);
+    todo_wine ok(mdl->MdlFlags & MDL_PAGES_LOCKED, "got flags %#x\n", mdl->MdlFlags);
 
     addr = MmMapLockedPages(mdl, KernelMode);
     ok(addr != NULL, "MmMapLockedPages failed\n");
+    ok(mdl->MdlFlags & MDL_MAPPED_TO_SYSTEM_VA, "got flags %#x\n", mdl->MdlFlags);
+    ok(mdl->MappedSystemVa == addr, "got %p, expected %p\n", mdl->MappedSystemVa, addr);
     if (addr != NULL)
         ok(!kmemcmp(addr, buffer, sizeof(buffer)), "Unexpected data in mapped memory\n");
 
     MmUnmapLockedPages(addr, mdl);
+    todo_wine ok(!(mdl->MdlFlags & MDL_MAPPED_TO_SYSTEM_VA), "got flags %#x\n", mdl->MdlFlags);
+    todo_wine ok(mdl->MdlFlags & MDL_PAGES_LOCKED, "got flags %#x\n", mdl->MdlFlags);
 
     addr = MmMapLockedPagesSpecifyCache(mdl, KernelMode, MmCached, NULL, FALSE, NormalPagePriority);
     ok(addr != NULL, "MmMapLockedPagesSpecifyCache failed\n");
+    ok(mdl->MdlFlags & MDL_MAPPED_TO_SYSTEM_VA, "got flags %#x\n", mdl->MdlFlags);
+    ok(mdl->MappedSystemVa == addr, "got %p, expected %p\n", mdl->MappedSystemVa, addr);
     if (addr != NULL)
         ok(!kmemcmp(addr, buffer, sizeof(buffer)), "Unexpected data in mapped memory\n");
 
     MmUnmapLockedPages(addr, mdl);
+    todo_wine ok(!(mdl->MdlFlags & MDL_MAPPED_TO_SYSTEM_VA), "got flags %#x\n", mdl->MdlFlags);
 
     MmUnlockPages(mdl);
+    ok(!(mdl->MdlFlags & MDL_PAGES_LOCKED), "got flags %#x\n", mdl->MdlFlags);
     IoFreeMdl(mdl);
 }
 
