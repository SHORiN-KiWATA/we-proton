+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <errno.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <net/if.h>
+
+#ifdef __linux__
+#include <sys/ioctl.h>
+#include <sys/socket.h>
+#include <linux/if_tun.h>
+#endif
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winnt.h"
+#include "winerror.h"
+#include "wine/unixlib.h"
+
+#include "unixlib.h"
+
+#define MAX_ADAPTERS 32
+
+struct unix_adapter
+{
+    char name[WINTUN_IFNAME_MAX];
+    int fd;
+    int wake[2];
+    int woken;
+    unsigned int index;
+    unsigned int refcount;
+};
+
+static struct unix_adapter *adapters[MAX_ADAPTERS];
+
+static struct unix_adapter *find_adapter( const char *name )
+{
+    unsigned int i;
+
+    for (i = 0; i < MAX_ADAPTERS; i++)
+        if (adapters[i] && !strcmp( adapters[i]->name, name )) return adapters[i];
+    return NULL;
+}
+
+static struct unix_adapter *find_adapter_ctx( UINT64 ctx )
+{
+    unsigned int i;
+
+    for (i = 0; i < MAX_ADAPTERS; i++)
+        if (adapters[i] == (struct unix_adapter *)(uintptr_t)ctx) return adapters[i];
+    return NULL;
+}
+
+static void add_adapter( struct unix_adapter *adapter )
+{
+    unsigned int i;
+
+    for (i = 0; i < MAX_ADAPTERS; i++)
+        if (!adapters[i]) { adapters[i] = adapter; return; }
+}
+
+static void remove_adapter( struct unix_adapter *adapter )
+{
+    unsigned int i;
+
+    for (i = 0; i < MAX_ADAPTERS; i++)
+        if (adapters[i] == adapter) { adapters[i] = NULL; return; }
+}
+
+static UINT errno_to_status( int err )
+{
+    switch (err)
+    {
+    case ENOENT: return ERROR_FILE_NOT_FOUND;
+    case EEXIST: return ERROR_ALREADY_EXISTS;
+    case EACCES:
+    case EPERM: return ERROR_ACCESS_DENIED;
+    case EBUSY: return ERROR_BUSY;
+    case EINVAL: return ERROR_INVALID_PARAMETER;
+    case ENODEV:
+    case ENXIO: return ERROR_NO_SUCH_DEVICE;
+    case ENOMEM: return ERROR_NOT_ENOUGH_MEMORY;
+    case ENOSPC: return ERROR_DISK_FULL;
+    case EAGAIN: return ERROR_NO_MORE_ITEMS;
+    default: return ERROR_GEN_FAILURE;
+    }
+}
+
+/* Derive the unix interface name from the adapter name, keeping it
+ * deterministic so that an adapter left behind by a crashed process can be
+ * opened again. Linux interface names are limited to 15 characters and may
+ * not contain spaces. */
+static void make_ifname( const WCHAR *name, char ifname[WINTUN_IFNAME_MAX] )
+{
+    static const char hex[] = "0123456789abcdef";
+    char tmp[64];
+    unsigned int i, len = 0;
+    UINT64 hash;
+
+    for (i = 0; name && name[i] && len < sizeof(tmp) - 1; i++)
+    {
+        WCHAR c = name[i];
+
+        if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') ||
+            c == '-' || c == '_')
+            tmp[len++] = (char)c;
+        else
+            tmp[len++] = '_';
+    }
+    tmp[len] = 0;
+    if (!len) { memcpy( tmp, "wintun", 7 ); len = 6; }
+
+    if (len <= WINTUN_IFNAME_MAX - 1)
+    {
+        memcpy( ifname, tmp, len + 1 );
+        return;
+    }
+
+    hash = 0xcbf29ce484222325ULL;
+    for (i = 0; name[i]; i++)
+    {
+        hash ^= (unsigned char)(name[i] & 0xff);
+        hash *= 0x100000001b3ULL;
+        hash ^= (unsigned char)(name[i] >> 8);
+        hash *= 0x100000001b3ULL;
+    }
+    memcpy( ifname, "wt_", 3 );
+    for (i = 0; i < 8; i++) ifname[3 + i] = hex[(hash >> (28 - 4 * i)) & 0xf];
+    ifname[11] = 0;
+}
+
+#ifdef __linux__
+
+static int make_pipe( int fds[2] )
+{
+    if (pipe( fds )) return -1;
+    fcntl( fds[0], F_SETFL, O_NONBLOCK );
+    fcntl( fds[1], F_SETFL, O_NONBLOCK );
+    fcntl( fds[0], F_SETFD, FD_CLOEXEC );
+    fcntl( fds[1], F_SETFD, FD_CLOEXEC );
+    return 0;
+}
+
+static int open_tun( const char *ifname, unsigned int *index )
+{
+    struct ifreq ifr;
+    int fd, sock, err;
+
+    if ((fd = open( "/dev/net/tun", O_RDWR | O_NONBLOCK )) < 0) return -1;
+    fcntl( fd, F_SETFD, FD_CLOEXEC );
+
+    memset( &ifr, 0, sizeof(ifr) );
+    memcpy( ifr.ifr_name, ifname, strlen( ifname ) );
+    ifr.ifr_flags = IFF_TUN | IFF_NO_PI | IFF_PERSIST;
+    if (ioctl( fd, TUNSETIFF, &ifr ) < 0)
+    {
+        err = errno;
+        close( fd );
+        errno = err;
+        return -1;
+    }
+
+    if ((sock = socket( AF_INET, SOCK_DGRAM, 0 )) >= 0)
+    {
+        memset( &ifr, 0, sizeof(ifr) );
+        memcpy( ifr.ifr_name, ifname, strlen( ifname ) );
+        if (!ioctl( sock, SIOCGIFFLAGS, &ifr ))
+        {
+            ifr.ifr_flags |= IFF_UP;
+            ioctl( sock, SIOCSIFFLAGS, &ifr );
+        }
+        close( sock );
+    }
+
+    if (index) *index = if_nametoindex( ifname );
+    return fd;
+}
+
+static void destroy_tun( struct unix_adapter *adapter )
+{
+    if (adapter->fd >= 0)
+    {
+        ioctl( adapter->fd, TUNSETPERSIST, 0 );
+        close( adapter->fd );
+        adapter->fd = -1;
+    }
+}
+
+static void close_pipe( struct unix_adapter *adapter )
+{
+    if (adapter->wake[0] >= 0) close( adapter->wake[0] );
+    if (adapter->wake[1] >= 0) close( adapter->wake[1] );
+    adapter->wake[0] = adapter->wake[1] = -1;
+}
+
+#else /* __linux__ */
+
+static int make_pipe( int fds[2] ) { (void)fds; return -1; }
+static int open_tun( const char *ifname, unsigned int *index )
+{
+    (void)ifname;
+    (void)index;
+    errno = ENOTSUP;
+    return -1;
+}
+static void destroy_tun( struct unix_adapter *adapter ) { (void)adapter; }
+static void close_pipe( struct unix_adapter *adapter ) { (void)adapter; }
+
+#endif /* __linux__ */
+
+static NTSTATUS wintun_create_adapter( void *args )
+{
+    struct wintun_create_params *params = args;
+    struct unix_adapter *adapter;
+    char ifname[WINTUN_IFNAME_MAX];
+
+    params->ctx = 0;
+    params->status = 0;
+    params->ifindex = 0;
+    memset( params->ifname, 0, sizeof(params->ifname) );
+
+    make_ifname( params->name, ifname );
+
+    if ((adapter = find_adapter( ifname )))
+    {
+        adapter->refcount++;
+        params->ctx = (UINT64)(uintptr_t)adapter;
+        params->ifindex = adapter->index;
+        memcpy( params->ifname, adapter->name, strlen( adapter->name ) + 1 );
+        return STATUS_SUCCESS;
+    }
+
+    if (!(adapter = calloc( 1, sizeof(*adapter) )))
+    {
+        params->status = ERROR_NOT_ENOUGH_MEMORY;
+        return STATUS_SUCCESS;
+    }
+    adapter->fd = -1;
+    adapter->wake[0] = adapter->wake[1] = -1;
+
+    if ((adapter->fd = open_tun( ifname, &adapter->index )) < 0)
+    {
+        params->status = errno_to_status( errno );
+        free( adapter );
+        return STATUS_SUCCESS;
+    }
+    adapter->refcount = 1;
+    if (make_pipe( adapter->wake ))
+    {
+        params->status = errno_to_status( errno );
+        destroy_tun( adapter );
+        free( adapter );
+        return STATUS_SUCCESS;
+    }
+
+    memcpy( adapter->name, ifname, strlen( ifname ) + 1 );
+    add_adapter( adapter );
+
+    params->ctx = (UINT64)(uintptr_t)adapter;
+    params->ifindex = adapter->index;
+    memcpy( params->ifname, ifname, strlen( ifname ) + 1 );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS wintun_open_adapter( void *args )
+{
+    struct wintun_open_params *params = args;
+    struct unix_adapter *adapter;
+    char ifname[WINTUN_IFNAME_MAX];
+
+    params->ctx = 0;
+    params->status = 0;
+    params->ifindex = 0;
+    memset( params->ifname, 0, sizeof(params->ifname) );
+
+    make_ifname( params->name, ifname );
+
+    if ((adapter = find_adapter( ifname )))
+    {
+        adapter->refcount++;
+        params->ctx = (UINT64)(uintptr_t)adapter;
+        params->ifindex = adapter->index;
+        memcpy( params->ifname, adapter->name, strlen( adapter->name ) + 1 );
+        return STATUS_SUCCESS;
+    }
+
+    if (!if_nametoindex( ifname ))
+    {
+        params->status = ERROR_NOT_FOUND;
+        return STATUS_SUCCESS;
+    }
+
+    if (!(adapter = calloc( 1, sizeof(*adapter) )))
+    {
+        params->status = ERROR_NOT_ENOUGH_MEMORY;
+        return STATUS_SUCCESS;
+    }
+    adapter->fd = -1;
+    adapter->wake[0] = adapter->wake[1] = -1;
+
+    if ((adapter->fd = open_tun( ifname, &adapter->index )) < 0)
+    {
+        params->status = errno_to_status( errno );
+        free( adapter );
+        return STATUS_SUCCESS;
+    }
+    adapter->refcount = 1;
+    if (make_pipe( adapter->wake ))
+    {
+        params->status = errno_to_status( errno );
+        destroy_tun( adapter );
+        free( adapter );
+        return STATUS_SUCCESS;
+    }
+
+    memcpy( adapter->name, ifname, strlen( ifname ) + 1 );
+    add_adapter( adapter );
+
+    params->ctx = (UINT64)(uintptr_t)adapter;
+    params->ifindex = adapter->index;
+    memcpy( params->ifname, ifname, strlen( ifname ) + 1 );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS wintun_close_adapter( void *args )
+{
+    struct wintun_close_params *params = args;
+    struct unix_adapter *adapter = find_adapter_ctx( params->ctx );
+
+    params->status = 0;
+    if (!adapter)
+    {
+        params->status = ERROR_INVALID_HANDLE;
+        return STATUS_SUCCESS;
+    }
+
+    if (--adapter->refcount) return STATUS_SUCCESS;
+
+    destroy_tun( adapter );
+    close_pipe( adapter );
+    remove_adapter( adapter );
+    free( adapter );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS wintun_read_packet( void *args )
+{
+    struct wintun_io_params *params = args;
+    struct unix_adapter *adapter = find_adapter_ctx( params->ctx );
+    ssize_t ret;
+
+    params->ret = 0;
+    params->status = 0;
+    if (!adapter)
+    {
+        params->status = ERROR_INVALID_HANDLE;
+        return STATUS_SUCCESS;
+    }
+
+    if ((ret = read( adapter->fd, (void *)(uintptr_t)params->buffer, params->size )) < 0)
+    {
+        params->status = errno_to_status( errno );
+        return STATUS_SUCCESS;
+    }
+    params->ret = ret;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS wintun_write_packet( void *args )
+{
+    struct wintun_io_params *params = args;
+    struct unix_adapter *adapter = find_adapter_ctx( params->ctx );
+    ssize_t ret;
+
+    params->ret = 0;
+    params->status = 0;
+    if (!adapter)
+    {
+        params->status = ERROR_INVALID_HANDLE;
+        return STATUS_SUCCESS;
+    }
+
+    if ((ret = write( adapter->fd, (void *)(uintptr_t)params->buffer, params->size )) < 0)
+    {
+        params->status = errno_to_status( errno );
+        return STATUS_SUCCESS;
+    }
+    params->ret = ret;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS wintun_wait_readable( void *args )
+{
+    struct wintun_wait_params *params = args;
+    struct unix_adapter *adapter = find_adapter_ctx( params->ctx );
+    struct pollfd fds[2];
+    int ret;
+
+    params->readable = 0;
+    params->woken = 0;
+    params->status = 0;
+    if (!adapter)
+    {
+        params->status = ERROR_INVALID_HANDLE;
+        return STATUS_SUCCESS;
+    }
+    if (adapter->woken)
+    {
+        params->woken = 1;
+        return STATUS_SUCCESS;
+    }
+
+    fds[0].fd = adapter->fd;
+    fds[0].events = POLLIN;
+    fds[0].revents = 0;
+    fds[1].fd = adapter->wake[0];
+    fds[1].events = POLLIN;
+    fds[1].revents = 0;
+
+    ret = poll( fds, 2, params->timeout == WINTUN_WAIT_INFINITE ? -1 : (int)params->timeout );
+    if (ret < 0)
+    {
+        params->status = errno_to_status( errno );
+        return STATUS_SUCCESS;
+    }
+    if (ret > 0 && (fds[0].revents & POLLIN)) params->readable = 1;
+    if (adapter->woken || (ret > 0 && (fds[1].revents & POLLIN))) params->woken = 1;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS wintun_wake( void *args )
+{
+    struct wintun_wake_params *params = args;
+    struct unix_adapter *adapter = find_adapter_ctx( params->ctx );
+    char c = 1;
+
+    params->status = 0;
+    if (!adapter)
+    {
+        params->status = ERROR_INVALID_HANDLE;
+        return STATUS_SUCCESS;
+    }
+
+    adapter->woken = 1;
+    if (adapter->wake[1] >= 0 && write( adapter->wake[1], &c, 1 ) < 0)
+    {
+        /* the wait thread has already noticed */
+    }
+    return STATUS_SUCCESS;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    wintun_create_adapter,
+    wintun_open_adapter,
+    wintun_close_adapter,
+    wintun_read_packet,
+    wintun_write_packet,
+    wintun_wait_readable,
+    wintun_wake,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_wintun_funcs_count );
+
+#ifdef _WIN64
+
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    wintun_create_adapter,
+    wintun_open_adapter,
+    wintun_close_adapter,
+    wintun_read_packet,
+    wintun_write_packet,
+    wintun_wait_readable,
+    wintun_wake,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_wow64_funcs) == unix_wintun_funcs_count );
+
+#endif /* _WIN64 */
