+#include <stdarg.h>
+#include <string.h>
+#include <windef.h>
+#include <winbase.h>
+#include <winerror.h>
+#include <winnt.h>
+#include <winsock2.h>
+#include <ws2ipdef.h>
+#include <ifdef.h>
+#include <nldef.h>
+#include <netioapi.h>
+
+#include <wine/debug.h>
+#include <wine/unixlib.h>
+
+#include "wintun.h"
+#include "unixlib.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(wintun);
+
+/* Version reported by WintunGetRunningDriverVersion: MAKELONG(minor, major),
+ * so 0.14 is 0x0000000e. Measured on Windows. */
+#define WINTUN_DRIVER_VERSION 0x0000000e
+
+struct _WINTUN_ADAPTER
+{
+    UINT64 ctx;
+    char ifname[WINTUN_IFNAME_MAX];
+    UINT ifindex;
+    NET_LUID luid;
+    BOOL have_luid;
+    struct _WINTUN_SESSION *session;
+};
+
+struct wintun_packet
+{
+    struct wintun_packet *next;
+    DWORD size;
+    BYTE data[1];
+};
+
+struct _WINTUN_SESSION
+{
+    struct _WINTUN_ADAPTER *adapter;
+    DWORD capacity;
+    HANDLE read_event;
+    HANDLE consume_event;
+    HANDLE thread;
+    BOOL stopping;
+    BYTE *scratch;
+    DWORD scratch_size;
+    DWORD rx_bytes;
+    DWORD tx_bytes;
+    struct wintun_packet *rx_head, *rx_tail;
+    struct wintun_packet *tx_head, *tx_tail;
+};
+
+static WINTUN_LOGGER_CALLBACK logger;
+static DWORD running_version;
+
+static BOOL get_interface_luid( UINT ifindex, NET_LUID *luid )
+{
+    if (!ConvertInterfaceIndexToLuid( ifindex, luid )) return TRUE;
+    WARN( "no luid for interface %u\n", ifindex );
+    return FALSE;
+}
+
+static void free_adapter( struct _WINTUN_ADAPTER *adapter )
+{
+    struct wintun_close_params params;
+
+    params.ctx = adapter->ctx;
+    params.status = 0;
+    WINE_UNIX_CALL( unix_wintun_close_adapter, &params );
+    HeapFree( GetProcessHeap(), 0, adapter );
+}
+
+BOOL WINAPI DllMain( HINSTANCE instance, DWORD reason, void *reserved )
+{
+    if (reason == DLL_PROCESS_ATTACH && __wine_init_unix_call()) return FALSE;
+    return TRUE;
+}
+
+WINTUN_ADAPTER_HANDLE WINAPI WintunCreateAdapter( LPCWSTR name, LPCWSTR tunnel_type, const GUID *requested_guid )
+{
+    struct wintun_create_params params;
+    struct _WINTUN_ADAPTER *adapter;
+    unsigned int i;
+
+    TRACE( "%s, %s, %p\n", debugstr_w(name), debugstr_w(tunnel_type), requested_guid );
+
+    if (!name || !*name)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+
+    memset( &params, 0, sizeof(params) );
+    for (i = 0; i + 1 < ARRAY_SIZE(params.name) && name[i]; i++) params.name[i] = name[i];
+
+    if (WINE_UNIX_CALL( unix_wintun_create_adapter, &params ) || params.status)
+    {
+        SetLastError( params.status ? params.status : ERROR_GEN_FAILURE );
+        return NULL;
+    }
+
+    if (!(adapter = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*adapter) )))
+    {
+        struct wintun_close_params close_params = { params.ctx, 0 };
+        WINE_UNIX_CALL( unix_wintun_close_adapter, &close_params );
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return NULL;
+    }
+
+    adapter->ctx = params.ctx;
+    memcpy( adapter->ifname, params.ifname, sizeof(adapter->ifname) );
+    adapter->ifindex = params.ifindex;
+    if (!(adapter->have_luid = get_interface_luid( adapter->ifindex, &adapter->luid )))
+    {
+        free_adapter( adapter );
+        SetLastError( ERROR_FILE_NOT_FOUND );
+        return NULL;
+    }
+    running_version = WINTUN_DRIVER_VERSION;
+
+    TRACE( "created %s, ifindex %u, luid %s\n", adapter->ifname, adapter->ifindex,
+           wine_dbgstr_longlong( adapter->luid.Value ) );
+    return adapter;
+}
+
+WINTUN_ADAPTER_HANDLE WINAPI WintunOpenAdapter( LPCWSTR name )
+{
+    struct wintun_open_params params;
+    struct _WINTUN_ADAPTER *adapter;
+    unsigned int i;
+
+    TRACE( "%s\n", debugstr_w(name) );
+
+    if (!name || !*name)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+
+    memset( &params, 0, sizeof(params) );
+    for (i = 0; i + 1 < ARRAY_SIZE(params.name) && name[i]; i++) params.name[i] = name[i];
+
+    if (WINE_UNIX_CALL( unix_wintun_open_adapter, &params ) || params.status)
+    {
+        SetLastError( params.status ? params.status : ERROR_GEN_FAILURE );
+        return NULL;
+    }
+
+    if (!(adapter = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*adapter) )))
+    {
+        struct wintun_close_params close_params = { params.ctx, 0 };
+        WINE_UNIX_CALL( unix_wintun_close_adapter, &close_params );
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return NULL;
+    }
+
+    adapter->ctx = params.ctx;
+    memcpy( adapter->ifname, params.ifname, sizeof(adapter->ifname) );
+    adapter->ifindex = params.ifindex;
+    if (!(adapter->have_luid = get_interface_luid( adapter->ifindex, &adapter->luid )))
+    {
+        free_adapter( adapter );
+        SetLastError( ERROR_FILE_NOT_FOUND );
+        return NULL;
+    }
+    running_version = WINTUN_DRIVER_VERSION;
+
+    TRACE( "opened %s, ifindex %u, luid %s\n", adapter->ifname, adapter->ifindex,
+           wine_dbgstr_longlong( adapter->luid.Value ) );
+    return adapter;
+}
+
+void WINAPI WintunCloseAdapter( WINTUN_ADAPTER_HANDLE handle )
+{
+    TRACE( "%p\n", handle );
+
+    if (!handle) return;
+    if (handle->session) WintunEndSession( handle->session );
+    free_adapter( handle );
+}
+
+BOOL WINAPI WintunDeleteDriver( void )
+{
+    TRACE( "\n" );
+    running_version = 0;
+    return TRUE;
+}
+
+void WINAPI WintunGetAdapterLUID( WINTUN_ADAPTER_HANDLE handle, LUID *luid )
+{
+    if (!luid) return;
+    if (!handle || !handle->have_luid)
+    {
+        memset( luid, 0, sizeof(*luid) );
+        return;
+    }
+    *(UINT64 *)luid = handle->luid.Value;
+}
+
+DWORD WINAPI WintunGetRunningDriverVersion( void )
+{
+    TRACE( "\n" );
+    return running_version;
+}
+
+void WINAPI WintunSetLogger( WINTUN_LOGGER_CALLBACK new_logger )
+{
+    logger = new_logger;
+}
+
+static DWORD WINAPI read_wait_thread( void *arg )
+{
+    struct _WINTUN_SESSION *session = arg;
+
+    for (;;)
+    {
+        struct wintun_wait_params params;
+
+        memset( &params, 0, sizeof(params) );
+        params.ctx = session->adapter->ctx;
+        params.timeout = WINTUN_WAIT_INFINITE;
+
+        if (WINE_UNIX_CALL( unix_wintun_wait_readable, &params )) break;
+        if (session->stopping || params.woken) break;
+        if (!params.readable) continue;
+
+        SetEvent( session->read_event );
+        WaitForSingleObject( session->consume_event, INFINITE );
+        if (session->stopping) break;
+        ResetEvent( session->consume_event );
+    }
+    return 0;
+}
+
+WINTUN_SESSION_HANDLE WINAPI WintunStartSession( WINTUN_ADAPTER_HANDLE handle, DWORD capacity )
+{
+    struct _WINTUN_SESSION *session;
+
+    TRACE( "%p, %lu\n", handle, capacity );
+
+    if (!handle)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    if (handle->session)
+    {
+        SetLastError( ERROR_ALREADY_INITIALIZED );  /* matches the Windows driver */
+        return NULL;
+    }
+    if (capacity < (128 * 1024) || capacity > (64 * 1024 * 1024) ||
+        (capacity & (capacity - 1)))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+
+    if (!(session = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*session) )))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return NULL;
+    }
+
+    session->adapter = handle;
+    session->capacity = capacity;
+    session->scratch_size = 65536;
+    session->scratch = HeapAlloc( GetProcessHeap(), 0, session->scratch_size );
+    session->read_event = CreateEventW( NULL, FALSE, FALSE, NULL );
+    session->consume_event = CreateEventW( NULL, FALSE, FALSE, NULL );
+
+    if (!session->scratch || !session->read_event || !session->consume_event)
+    {
+        if (session->read_event) CloseHandle( session->read_event );
+        if (session->consume_event) CloseHandle( session->consume_event );
+        if (session->scratch) HeapFree( GetProcessHeap(), 0, session->scratch );
+        HeapFree( GetProcessHeap(), 0, session );
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return NULL;
+    }
+
+    if (!(session->thread = CreateThread( NULL, 0, read_wait_thread, session, 0, NULL )))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        CloseHandle( session->read_event );
+        CloseHandle( session->consume_event );
+        HeapFree( GetProcessHeap(), 0, session->scratch );
+        HeapFree( GetProcessHeap(), 0, session );
+        return NULL;
+    }
+
+    handle->session = session;
+    return session;
+}
+
+void WINAPI WintunEndSession( WINTUN_SESSION_HANDLE session )
+{
+    struct wintun_wake_params params;
+
+    TRACE( "%p\n", session );
+
+    if (!session) return;
+
+    session->stopping = TRUE;
+    if (session->consume_event) SetEvent( session->consume_event );
+    params.ctx = session->adapter->ctx;
+    params.status = 0;
+    WINE_UNIX_CALL( unix_wintun_wake, &params );
+
+    if (session->thread)
+    {
+        WaitForSingleObject( session->thread, INFINITE );
+        CloseHandle( session->thread );
+    }
+
+    while (session->rx_head)
+    {
+        struct wintun_packet *packet = session->rx_head;
+        session->rx_head = packet->next;
+        HeapFree( GetProcessHeap(), 0, packet );
+    }
+    while (session->tx_head)
+    {
+        struct wintun_packet *packet = session->tx_head;
+        session->tx_head = packet->next;
+        HeapFree( GetProcessHeap(), 0, packet );
+    }
+
+    if (session->read_event) CloseHandle( session->read_event );
+    if (session->consume_event) CloseHandle( session->consume_event );
+    if (session->scratch) HeapFree( GetProcessHeap(), 0, session->scratch );
+
+    session->adapter->session = NULL;
+    HeapFree( GetProcessHeap(), 0, session );
+}
+
+HANDLE WINAPI WintunGetReadWaitEvent( WINTUN_SESSION_HANDLE session )
+{
+    if (!session)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    return session->read_event;
+}
+
+BYTE *WINAPI WintunReceivePacket( WINTUN_SESSION_HANDLE session, DWORD *packet_size )
+{
+    struct wintun_io_params params;
+    struct wintun_packet *packet;
+
+    if (!session || !packet_size)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    if (session->rx_bytes >= session->capacity)
+    {
+        SetLastError( ERROR_NO_MORE_ITEMS );
+        return NULL;
+    }
+
+    memset( &params, 0, sizeof(params) );
+    params.ctx = session->adapter->ctx;
+    params.buffer = (UINT64)(ULONG_PTR)session->scratch;
+    params.size = session->scratch_size;
+
+    if (WINE_UNIX_CALL( unix_wintun_read_packet, &params ) || params.status || !params.ret)
+    {
+        SetLastError( params.status ? params.status : ERROR_NO_MORE_ITEMS );
+        return NULL;
+    }
+
+    if (!(packet = HeapAlloc( GetProcessHeap(), 0, FIELD_OFFSET( struct wintun_packet, data ) + params.ret )))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return NULL;
+    }
+    packet->size = params.ret;
+    packet->next = NULL;
+    memcpy( packet->data, session->scratch, params.ret );
+
+    if (session->rx_tail) session->rx_tail->next = packet;
+    else session->rx_head = packet;
+    session->rx_tail = packet;
+    session->rx_bytes += params.ret;
+
+    SetEvent( session->consume_event );
+    *packet_size = params.ret;
+    return packet->data;
+}
+
+void WINAPI WintunReleaseReceivePacket( WINTUN_SESSION_HANDLE session, const BYTE *data )
+{
+    struct wintun_packet *packet, *prev = NULL;
+
+    if (!session || !data) return;
+
+    for (packet = session->rx_head; packet; prev = packet, packet = packet->next)
+    {
+        if (packet->data != data) continue;
+        if (prev) prev->next = packet->next;
+        else session->rx_head = packet->next;
+        if (session->rx_tail == packet) session->rx_tail = prev;
+        session->rx_bytes -= packet->size;
+        HeapFree( GetProcessHeap(), 0, packet );
+        return;
+    }
+    WARN( "unknown packet %p\n", data );
+}
+
+BYTE *WINAPI WintunAllocateSendPacket( WINTUN_SESSION_HANDLE session, DWORD packet_size )
+{
+    struct wintun_packet *packet;
+
+    if (!session || !packet_size)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    if (session->tx_bytes + packet_size > session->capacity)
+    {
+        SetLastError( ERROR_BUFFER_OVERFLOW );
+        return NULL;
+    }
+
+    if (!(packet = HeapAlloc( GetProcessHeap(), 0, FIELD_OFFSET( struct wintun_packet, data ) + packet_size )))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return NULL;
+    }
+    packet->size = packet_size;
+    packet->next = NULL;
+
+    if (session->tx_tail) session->tx_tail->next = packet;
+    else session->tx_head = packet;
+    session->tx_tail = packet;
+    session->tx_bytes += packet_size;
+    return packet->data;
+}
+
+void WINAPI WintunSendPacket( WINTUN_SESSION_HANDLE session, const BYTE *data )
+{
+    struct wintun_packet *packet, *prev = NULL;
+    struct wintun_io_params params;
+
+    if (!session || !data) return;
+
+    for (packet = session->tx_head; packet; prev = packet, packet = packet->next)
+        if (packet->data == data) break;
+    if (!packet)
+    {
+        WARN( "unknown packet %p\n", data );
+        return;
+    }
+
+    memset( &params, 0, sizeof(params) );
+    params.ctx = session->adapter->ctx;
+    params.buffer = (UINT64)(ULONG_PTR)data;
+    params.size = packet->size;
+    if (WINE_UNIX_CALL( unix_wintun_write_packet, &params ))
+        WARN( "write call failed\n" );
+    else if (params.status)
+        WARN( "write failed, status %lu\n", params.status );
+
+    if (prev) prev->next = packet->next;
+    else session->tx_head = packet->next;
+    if (session->tx_tail == packet) session->tx_tail = prev;
+    session->tx_bytes -= packet->size;
+    HeapFree( GetProcessHeap(), 0, packet );
+}
