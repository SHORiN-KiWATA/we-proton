+#ifndef __WINTUN_UNIXLIB_H
+#define __WINTUN_UNIXLIB_H
+
+#include <stdarg.h>
+#include <windef.h>
+#include <winnt.h>
+#include <wine/unixlib.h>
+
+#define WINTUN_NAME_MAX 64
+#define WINTUN_IFNAME_MAX 16
+#define WINTUN_WAIT_INFINITE 0xffffffff
+
+enum wintun_unix_funcs
+{
+    unix_wintun_create_adapter,
+    unix_wintun_open_adapter,
+    unix_wintun_close_adapter,
+    unix_wintun_read_packet,
+    unix_wintun_write_packet,
+    unix_wintun_wait_readable,
+    unix_wintun_wake,
+    unix_wintun_funcs_count,
+};
+
+/* These structures cross the PE/unix boundary as-is, also under WoW64, so
+ * their layout must not depend on the pointer size: 64-bit members come
+ * first and addresses are passed as UINT64. */
+
+struct wintun_create_params
+{
+    UINT64 ctx;                       /* out: unix adapter context */
+    UINT status;                      /* out: Win32 error code */
+    UINT ifindex;                     /* out */
+    WCHAR name[WINTUN_NAME_MAX];      /* in */
+    char ifname[WINTUN_IFNAME_MAX];   /* out */
+};
+
+struct wintun_open_params
+{
+    UINT64 ctx;                       /* out */
+    UINT status;                      /* out */
+    UINT ifindex;                     /* out */
+    WCHAR name[WINTUN_NAME_MAX];      /* in */
+    char ifname[WINTUN_IFNAME_MAX];   /* out */
+};
+
+struct wintun_io_params
+{
+    UINT64 ctx;      /* in */
+    UINT64 buffer;   /* in: address in this process */
+    UINT size;       /* in */
+    UINT ret;        /* out: bytes read or written */
+    UINT status;     /* out */
+};
+
+struct wintun_wait_params
+{
+    UINT64 ctx;      /* in */
+    UINT timeout;    /* in: milliseconds, WINTUN_WAIT_INFINITE waits forever */
+    UINT readable;   /* out */
+    UINT woken;      /* out */
+    UINT status;     /* out */
+};
+
+struct wintun_close_params
+{
+    UINT64 ctx;      /* in */
+    UINT status;     /* out */
+};
+
+struct wintun_wake_params
+{
+    UINT64 ctx;      /* in */
+    UINT status;     /* out */
+};
+
+#endif /* __WINTUN_UNIXLIB_H */
