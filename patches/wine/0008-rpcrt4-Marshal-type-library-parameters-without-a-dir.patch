From 7e6456c89e6c4b6fa78317174929c78aebfe5f1c Mon Sep 17 00:00:00 2001
From: shorinkiwata <fcl709@outlook.com>
Date: Thu, 8 Oct 2026 18:58:06 +0900
Subject: [PATCH] rpcrt4: Marshal type library parameters without a direction
 as [in, out].

Type libraries created with ICreateTypeInfo or by older compilers can
leave wParamFlags at 0. Windows marshals such parameters as [in, out]
when the callee can write through them: the value pointed to is sent to
the server and the value the server stores is sent back. Interface
pointers passed by value stay [in].

We treated them as [in] only, so out-of-process servers that return
results through such parameters appeared to return nothing.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 dlls/rpcrt4/ndr_typelib.c | 30 ++++++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/dlls/rpcrt4/ndr_typelib.c b/dlls/rpcrt4/ndr_typelib.c
index 1006bf1d3a0..69063dd811c 100644
--- a/dlls/rpcrt4/ndr_typelib.c
+++ b/dlls/rpcrt4/ndr_typelib.c
@@ -241,6 +241,32 @@ static BOOL type_pointer_is_iface(ITypeInfo *typeinfo, TYPEDESC *tdesc)
     return ret;
 }
 
+/* Whether the type is a pointer the callee can write through, as opposed to an
+ * interface pointer passed by value. */
+static BOOL type_is_ref_pointer(ITypeInfo *typeinfo, TYPEDESC *tdesc)
+{
+    ITypeInfo *refinfo;
+    BOOL ret = FALSE;
+    TYPEATTR *attr;
+
+    if (tdesc->vt == VT_PTR)
+        return !type_pointer_is_iface(typeinfo, tdesc->lptdesc);
+
+    if (tdesc->vt == VT_USERDEFINED)
+    {
+        ITypeInfo_GetRefTypeInfo(typeinfo, tdesc->hreftype, &refinfo);
+        ITypeInfo_GetTypeAttr(refinfo, &attr);
+
+        if (attr->typekind == TKIND_ALIAS)
+            ret = type_is_ref_pointer(refinfo, &attr->tdescAlias);
+
+        ITypeInfo_ReleaseTypeAttr(refinfo, attr);
+        ITypeInfo_Release(refinfo);
+    }
+
+    return ret;
+}
+
 static unsigned char get_array_fc(ITypeInfo *typeinfo, TYPEDESC *desc);
 static unsigned char get_struct_fc(ITypeInfo *typeinfo, TYPEATTR *attr);
 
@@ -1086,6 +1112,10 @@ static HRESULT write_param_fs(ITypeInfo *typeinfo, unsigned char *type,
 
     is_out = param_flags & PARAMFLAG_FOUT;
     is_in = (param_flags & PARAMFLAG_FIN) || (!is_out && !is_return);
+    /* Parameters without a direction are [in, out] when the callee can write
+     * through them. */
+    if (!(param_flags & (PARAMFLAG_FIN | PARAMFLAG_FOUT)) && !is_return)
+        is_out = type_is_ref_pointer(typeinfo, tdesc);
 
     hr = get_param_info(typeinfo, tdesc, is_in, is_out, byval, &server_size, &flags,
             &basetype, &tfs_tdesc);
-- 
2.56.0

