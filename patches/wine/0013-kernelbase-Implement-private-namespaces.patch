+/***********************************************************************
+ * Private namespaces
+ *
+ * A private namespace is a directory object identified by a boundary descriptor: the
+ * boundary name (case sensitive) and its set of SIDs and integrity labels (in any order).
+ * We keep them as directories under \PrivateNamespaces, named after the boundary. The alias
+ * prefix is local to the process: "<alias>\<name>" in the object functions refers to <name>
+ * in the namespace that was created or opened with that alias.
+ ***********************************************************************/
+
+struct private_namespace
+{
+    struct list entry;
+    HANDLE      handle;
+    WCHAR       alias[1];
+};
+
+static struct list private_namespaces = LIST_INIT( private_namespaces );
+static RTL_SRWLOCK private_namespace_lock = RTL_SRWLOCK_INIT;
+
+static void append_escaped( WCHAR *dst, SIZE_T *pos, const WCHAR *src, SIZE_T len )
+{
+    SIZE_T i;
+
+    for (i = 0; i < len; i++)
+    {
+        if (src[i] == '\\' || src[i] == '%' || src[i] == ';')
+        {
+            if (dst) swprintf( dst + *pos, 4, L"%%%02X", src[i] );
+            *pos += 3;
+        }
+        else
+        {
+            if (dst) dst[*pos] = src[i];
+            (*pos)++;
+        }
+    }
+}
+
+/* build "\PrivateNamespaces\<name>;<sid>;...;IL:<sid>" with the SIDs sorted */
+static NTSTATUS get_private_namespace_name( const OBJECT_BOUNDARY_DESCRIPTOR *desc, UNICODE_STRING *ret )
+{
+    static const WCHAR prefix[] = L"\\PrivateNamespaces\\";
+    const OBJECT_BOUNDARY_ENTRY *entry;
+    WCHAR **sids = NULL, *buffer = NULL;
+    const WCHAR *name = NULL;
+    SIZE_T name_len = 0, count = 0, pos, i, len;
+    ULONG offset;
+    NTSTATUS status = STATUS_INVALID_PARAMETER;
+
+    if (!desc || desc->Version != 1 || desc->TotalSize < sizeof(*desc)) return STATUS_INVALID_PARAMETER;
+    if (!(sids = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, desc->Items * sizeof(*sids) ))) return STATUS_NO_MEMORY;
+
+    for (i = 0, offset = sizeof(*desc); i < desc->Items; i++, offset = (offset + entry->EntrySize + 7) & ~7)
+    {
+        UNICODE_STRING str;
+
+        if (offset + sizeof(*entry) > desc->TotalSize) goto done;
+        entry = (const OBJECT_BOUNDARY_ENTRY *)((const char *)desc + offset);
+        if (entry->EntrySize < sizeof(*entry) || offset + entry->EntrySize > desc->TotalSize) goto done;
+
+        switch (entry->EntryType)
+        {
+        case OBNS_Name:
+            name = (const WCHAR *)(entry + 1);
+            name_len = (entry->EntrySize - sizeof(*entry)) / sizeof(WCHAR);
+            break;
+        case OBNS_SID:
+        case OBNS_IL:
+            if (!RtlValidSid( (PSID)(entry + 1) )) goto done;
+            if ((status = RtlConvertSidToUnicodeString( &str, (PSID)(entry + 1), TRUE ))) goto done;
+            status = STATUS_INVALID_PARAMETER;
+            if (!(sids[count] = HeapAlloc( GetProcessHeap(), 0, str.Length + 4 * sizeof(WCHAR) )))
+            {
+                RtlFreeUnicodeString( &str );
+                status = STATUS_NO_MEMORY;
+                goto done;
+            }
+            swprintf( sids[count++], str.Length / sizeof(WCHAR) + 4, L"%s%.*s",
+                      entry->EntryType == OBNS_IL ? L"IL:" : L"", (int)(str.Length / sizeof(WCHAR)), str.Buffer );
+            RtlFreeUnicodeString( &str );
+            break;
+        default:
+            goto done;
+        }
+    }
+    if (!name || !name_len) goto done;
+
+    /* the order of the SIDs doesn't matter */
+    for (i = 1; i < count; i++)
+    {
+        WCHAR *sid = sids[i];
+        for (len = i; len > 0 && wcscmp( sids[len - 1], sid ) > 0; len--) sids[len] = sids[len - 1];
+        sids[len] = sid;
+    }
+
+    pos = wcslen( prefix );
+    append_escaped( NULL, &pos, name, name_len );
+    for (i = 0; i < count; i++) pos += 1 + wcslen( sids[i] );
+    if (pos * sizeof(WCHAR) > 0xfffe)
+    {
+        status = STATUS_NAME_TOO_LONG;
+        goto done;
+    }
+    if (!(buffer = HeapAlloc( GetProcessHeap(), 0, (pos + 1) * sizeof(WCHAR) )))
+    {
+        status = STATUS_NO_MEMORY;
+        goto done;
+    }
+    wcscpy( buffer, prefix );
+    pos = wcslen( prefix );
+    append_escaped( buffer, &pos, name, name_len );
+    for (i = 0; i < count; i++)
+    {
+        buffer[pos++] = ';';
+        len = wcslen( sids[i] );
+        memcpy( buffer + pos, sids[i], len * sizeof(WCHAR) );
+        pos += len;
+    }
+    buffer[pos] = 0;
+    ret->Buffer = buffer;
+    ret->Length = pos * sizeof(WCHAR);
+    ret->MaximumLength = ret->Length + sizeof(WCHAR);
+    buffer = NULL;
+    status = STATUS_SUCCESS;
+
+done:
+    for (i = 0; i < count; i++) HeapFree( GetProcessHeap(), 0, sids[i] );
+    HeapFree( GetProcessHeap(), 0, sids );
+    HeapFree( GetProcessHeap(), 0, buffer );
+    return status;
+}
+
+static struct private_namespace *find_private_namespace_alias( const WCHAR *alias )
+{
+    struct private_namespace *ns;
+
+    LIST_FOR_EACH_ENTRY( ns, &private_namespaces, struct private_namespace, entry )
+        if (!wcsicmp( ns->alias, alias )) return ns;
+    return NULL;
+}
+
+static HANDLE create_or_open_private_namespace( SECURITY_ATTRIBUTES *sa, void *desc, const WCHAR *alias,
+                                                BOOL create )
+{
+    struct private_namespace *ns;
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING name;
+    HANDLE root = 0, ret = 0;
+    NTSTATUS status;
+
+    if (!alias) alias = L"";
+
+    if ((status = get_private_namespace_name( desc, &name )))
+    {
+        SetLastError( RtlNtStatusToDosError( status ));
+        return 0;
+    }
+    if (!(ns = HeapAlloc( GetProcessHeap(), 0, offsetof( struct private_namespace, alias[wcslen( alias ) + 1] ))))
+    {
+        HeapFree( GetProcessHeap(), 0, name.Buffer );
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return 0;
+    }
+    wcscpy( ns->alias, alias );
+
+    RtlAcquireSRWLockExclusive( &private_namespace_lock );
+
+    if (create)
+    {
+        UNICODE_STRING root_name;
+
+        /* the parent directory goes away by itself when the last namespace does */
+        root_name.Buffer = name.Buffer;
+        root_name.Length = root_name.MaximumLength = wcslen( L"\\PrivateNamespaces" ) * sizeof(WCHAR);
+        InitializeObjectAttributes( &attr, &root_name, OBJ_OPENIF, 0, NULL );
+        status = NtCreateDirectoryObject( &root, DIRECTORY_CREATE_OBJECT | DIRECTORY_TRAVERSE, &attr );
+        if (NT_SUCCESS( status ))
+        {
+            InitializeObjectAttributes( &attr, &name, (sa && sa->bInheritHandle) ? OBJ_INHERIT : 0, 0,
+                                        sa ? sa->lpSecurityDescriptor : NULL );
+            status = NtCreateDirectoryObject( &ret, DIRECTORY_ALL_ACCESS, &attr );
+            NtClose( root );
+        }
+    }
+    else
+    {
+        InitializeObjectAttributes( &attr, &name, 0, 0, NULL );
+        status = NtOpenDirectoryObject( &ret, DIRECTORY_ALL_ACCESS, &attr );
+        if (status == STATUS_OBJECT_NAME_NOT_FOUND) status = STATUS_OBJECT_PATH_NOT_FOUND;
+    }
+
+    /* the namespace has to exist before the alias is checked */
+    if (!status && find_private_namespace_alias( alias ))
+    {
+        NtClose( ret );
+        ret = 0;
+        status = STATUS_DUPLICATE_NAME;
+    }
+    if (!status)
+    {
+        ns->handle = ret;
+        list_add_tail( &private_namespaces, &ns->entry );
+        ns = NULL;
+    }
+
+    RtlReleaseSRWLockExclusive( &private_namespace_lock );
+
+    TRACE( "%s %s alias %s -> %p, status %#lx\n", create ? "create" : "open", debugstr_wn( name.Buffer, name.Length / sizeof(WCHAR) ),
+           debugstr_w(alias), ret, status );
+    HeapFree( GetProcessHeap(), 0, ns );
+    HeapFree( GetProcessHeap(), 0, name.Buffer );
+    if (status)
+    {
+        SetLastError( RtlNtStatusToDosError( status ));
+        return 0;
+    }
+    return ret;
+}
+
+
+/***********************************************************************
+ *           CreatePrivateNamespaceW   (kernelbase.@)
+ */
+HANDLE WINAPI CreatePrivateNamespaceW( SECURITY_ATTRIBUTES *sa, void *desc, const WCHAR *alias )
+{
+    TRACE( "%p, %p, %s\n", sa, desc, debugstr_w(alias) );
+    return create_or_open_private_namespace( sa, desc, alias, TRUE );
+}
+
+
+/***********************************************************************
+ *           OpenPrivateNamespaceW   (kernelbase.@)
+ */
+HANDLE WINAPI OpenPrivateNamespaceW( void *desc, const WCHAR *alias )
+{
+    TRACE( "%p, %s\n", desc, debugstr_w(alias) );
+    return create_or_open_private_namespace( NULL, desc, alias, FALSE );
+}
+
+
+/***********************************************************************
+ *           ClosePrivateNamespace   (kernelbase.@)
+ */
+BOOLEAN WINAPI ClosePrivateNamespace( HANDLE handle, ULONG flags )
+{
+    struct private_namespace *ns, *next;
+
+    TRACE( "%p, %#lx\n", handle, flags );
+
+    if (flags & PRIVATE_NAMESPACE_FLAG_DESTROY) FIXME( "ignoring PRIVATE_NAMESPACE_FLAG_DESTROY\n" );
+
+    RtlAcquireSRWLockExclusive( &private_namespace_lock );
+    LIST_FOR_EACH_ENTRY_SAFE( ns, next, &private_namespaces, struct private_namespace, entry )
+    {
+        if (ns->handle != handle) continue;
+        list_remove( &ns->entry );
+        HeapFree( GetProcessHeap(), 0, ns );
+    }
+    RtlReleaseSRWLockExclusive( &private_namespace_lock );
+
+    return set_ntstatus( NtClose( handle ));
+}
+
+
+/***********************************************************************
+ *           BasepAdjustObjectAttributesForPrivateNamespace   (kernelbase.@)
+ *
+ * Turn "<alias>\<name>" into <name> relative to the namespace with that alias.
+ */
+void WINAPI BasepAdjustObjectAttributesForPrivateNamespace( OBJECT_ATTRIBUTES *attr )
+{
+    UNICODE_STRING *name = attr->ObjectName;
+    struct private_namespace *ns, *found = NULL;
+    SIZE_T len, found_len = 0;
+
+    if (!name || !name->Length) return;
+
+    RtlAcquireSRWLockShared( &private_namespace_lock );
+    LIST_FOR_EACH_ENTRY( ns, &private_namespaces, struct private_namespace, entry )
+    {
+        len = wcslen( ns->alias );
+        if (len >= name->Length / sizeof(WCHAR) || name->Buffer[len] != '\\') continue;
+        if (wcsnicmp( name->Buffer, ns->alias, len )) continue;
+        if (!found || len > found_len)
+        {
+            found = ns;
+            found_len = len;
+        }
+    }
+    if (found)
+    {
+        attr->RootDirectory = found->handle;
+        name->Buffer += found_len + 1;
+        name->Length -= (found_len + 1) * sizeof(WCHAR);
+        name->MaximumLength -= (found_len + 1) * sizeof(WCHAR);
+    }
+    RtlReleaseSRWLockShared( &private_namespace_lock );
+}
+
+
 static void get_create_object_attributes( OBJECT_ATTRIBUTES *attr, UNICODE_STRING *nameW,
                                           SECURITY_ATTRIBUTES *sa, const WCHAR *name )
 {
@@ -101,6 +403,7 @@ static void get_create_object_attributes( OBJECT_ATTRIBUTES *attr, UNICODE_STRIN
         RtlInitUnicodeString( nameW, name );
         attr->ObjectName = nameW;
         BaseGetNamedObjectDirectory( &attr->RootDirectory );
+        BasepAdjustObjectAttributesForPrivateNamespace( attr );
     }
 }
 
@@ -117,6 +420,7 @@ static BOOL get_open_object_attributes( OBJECT_ATTRIBUTES *attr, UNICODE_STRING
     RtlInitUnicodeString( nameW, name );
     BaseGetNamedObjectDirectory( &dir );
     InitializeObjectAttributes( attr, nameW, inherit ? OBJ_INHERIT : 0, dir, NULL );
+    BasepAdjustObjectAttributesForPrivateNamespace( attr );
     return TRUE;
 }
 
