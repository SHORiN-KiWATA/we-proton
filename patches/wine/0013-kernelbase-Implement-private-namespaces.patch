+++ b/dlls/kernel32/kernel_main.c
@@ -220,6 +220,65 @@ BOOL WINAPI GetSystemRegistryQuota(PDWORD pdwQuotaAllowed, PDWORD pdwQuotaUsed)
  */
 HANDLE WINAPI CreateBoundaryDescriptorA(LPCSTR name, ULONG flags)
 {
-    FIXME("%s, %#lx - stub\n", debugstr_a(name), flags);
-    return NULL;
+    UNICODE_STRING nameW;
+    HANDLE ret;
+
+    if (!name) return CreateBoundaryDescriptorW( NULL, flags );
+    if (!RtlCreateUnicodeStringFromAsciiz( &nameW, name ))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return NULL;
+    }
+    ret = CreateBoundaryDescriptorW( nameW.Buffer, flags );
+    RtlFreeUnicodeString( &nameW );
+    return ret;
+}
+
+/******************************************************************************
+ *          AddIntegrityLabelToBoundaryDescriptor    (KERNEL32.@)
+ */
+BOOL WINAPI AddIntegrityLabelToBoundaryDescriptor( HANDLE *desc, PSID label )
+{
+    NTSTATUS status = RtlAddIntegrityLabelToBoundaryDescriptor( (OBJECT_BOUNDARY_DESCRIPTOR **)desc, label );
+
+    if (status) SetLastError( RtlNtStatusToDosError( status ));
+    return !status;
+}
+
+/******************************************************************************
+ *          CreatePrivateNamespaceA    (KERNEL32.@)
+ */
+HANDLE WINAPI CreatePrivateNamespaceA( SECURITY_ATTRIBUTES *sa, void *desc, const char *alias )
+{
+    UNICODE_STRING aliasW;
+    HANDLE ret;
+
+    if (!alias) return CreatePrivateNamespaceW( sa, desc, NULL );
+    if (!RtlCreateUnicodeStringFromAsciiz( &aliasW, alias ))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return NULL;
+    }
+    ret = CreatePrivateNamespaceW( sa, desc, aliasW.Buffer );
+    RtlFreeUnicodeString( &aliasW );
+    return ret;
+}
+
+/******************************************************************************
+ *          OpenPrivateNamespaceA    (KERNEL32.@)
+ */
+HANDLE WINAPI OpenPrivateNamespaceA( void *desc, const char *alias )
+{
+    UNICODE_STRING aliasW;
+    HANDLE ret;
+
+    if (!alias) return OpenPrivateNamespaceW( desc, NULL );
+    if (!RtlCreateUnicodeStringFromAsciiz( &aliasW, alias ))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return NULL;
+    }
+    ret = OpenPrivateNamespaceW( desc, aliasW.Buffer );
+    RtlFreeUnicodeString( &aliasW );
+    return ret;
 }
