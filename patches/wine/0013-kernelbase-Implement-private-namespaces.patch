diff --git a/dlls/ntdll/sec.c b/dlls/ntdll/sec.c
index f25436387c9..47a8b5df04f 100644
--- a/dlls/ntdll/sec.c
+++ b/dlls/ntdll/sec.c
@@ -1946,3 +1946,84 @@ NTSTATUS WINAPI RtlDeriveCapabilitySidsFromName( UNICODE_STRING *cap_name, PSID
 
     return STATUS_SUCCESS;
 }
+
+/* Boundary descriptors: a header followed by a name entry, then SID and integrity label
+ * entries. Each entry starts at an 8-byte aligned offset; the name entry's size is not
+ * rounded up, a SID entry's size is. */
+
+/******************************************************************************
+ * RtlCreateBoundaryDescriptor (NTDLL.@)
+ */
+OBJECT_BOUNDARY_DESCRIPTOR * WINAPI RtlCreateBoundaryDescriptor( UNICODE_STRING *name, ULONG flags )
+{
+    OBJECT_BOUNDARY_DESCRIPTOR *desc;
+    OBJECT_BOUNDARY_ENTRY *entry;
+    ULONG size;
+
+    TRACE( "%s, %#lx\n", debugstr_us(name), flags );
+
+    if (!name || !name->Length) return NULL;
+
+    size = sizeof(*desc) + ((sizeof(*entry) + name->Length + 7) & ~7);
+    if (!(desc = RtlAllocateHeap( GetProcessHeap(), HEAP_ZERO_MEMORY, size ))) return NULL;
+    desc->Version = 1;
+    desc->Items = 1;
+    desc->TotalSize = size;
+    desc->Flags = flags;
+    entry = (OBJECT_BOUNDARY_ENTRY *)(desc + 1);
+    entry->EntryType = OBNS_Name;
+    entry->EntrySize = sizeof(*entry) + name->Length;
+    memcpy( entry + 1, name->Buffer, name->Length );
+    return desc;
+}
+
+static NTSTATUS add_boundary_entry( OBJECT_BOUNDARY_DESCRIPTOR **desc, BOUNDARY_ENTRY_TYPE type, PSID sid )
+{
+    OBJECT_BOUNDARY_DESCRIPTOR *new_desc;
+    OBJECT_BOUNDARY_ENTRY *entry;
+    ULONG sid_len, entry_size;
+
+    if (!desc || !*desc || !sid || !RtlValidSid( sid )) return STATUS_INVALID_PARAMETER;
+
+    sid_len = RtlLengthSid( sid );
+    entry_size = sizeof(*entry) + ((sid_len + 7) & ~7);
+    if (!(new_desc = RtlAllocateHeap( GetProcessHeap(), HEAP_ZERO_MEMORY, (*desc)->TotalSize + entry_size )))
+        return STATUS_NO_MEMORY;
+    memcpy( new_desc, *desc, (*desc)->TotalSize );
+    entry = (OBJECT_BOUNDARY_ENTRY *)((char *)new_desc + new_desc->TotalSize);
+    entry->EntryType = type;
+    entry->EntrySize = entry_size;
+    memcpy( entry + 1, sid, sid_len );
+    new_desc->Items++;
+    new_desc->TotalSize += entry_size;
+    RtlFreeHeap( GetProcessHeap(), 0, *desc );
+    *desc = new_desc;
+    return STATUS_SUCCESS;
+}
+
+/******************************************************************************
+ * RtlAddSIDToBoundaryDescriptor (NTDLL.@)
+ */
+NTSTATUS WINAPI RtlAddSIDToBoundaryDescriptor( OBJECT_BOUNDARY_DESCRIPTOR **desc, PSID sid )
+{
+    TRACE( "%p, %p\n", desc, sid );
+    return add_boundary_entry( desc, OBNS_SID, sid );
+}
+
+/******************************************************************************
+ * RtlAddIntegrityLabelToBoundaryDescriptor (NTDLL.@)
+ */
+NTSTATUS WINAPI RtlAddIntegrityLabelToBoundaryDescriptor( OBJECT_BOUNDARY_DESCRIPTOR **desc, PSID sid )
+{
+    TRACE( "%p, %p\n", desc, sid );
+    return add_boundary_entry( desc, OBNS_IL, sid );
+}
+
+/******************************************************************************
+ * RtlDeleteBoundaryDescriptor (NTDLL.@)
+ */
+void WINAPI RtlDeleteBoundaryDescriptor( OBJECT_BOUNDARY_DESCRIPTOR *desc )
+{
+    TRACE( "%p\n", desc );
+    RtlFreeHeap( GetProcessHeap(), 0, desc );
+}
