+/******************************************************************
+ *    GetIpForwardEntry2 (IPHLPAPI.@)
+ */
+DWORD WINAPI GetIpForwardEntry2( MIB_IPFORWARD_ROW2 *row )
+{
+    MIB_IPFORWARD_TABLE2 *table;
+    const MIB_IPFORWARD_ROW2 *entry;
+    USHORT fam;
+    NET_LUID luid;
+    DWORD err, i;
+
+    TRACE( "%p.\n", row );
+
+    if (!row) return ERROR_INVALID_PARAMETER;
+    fam = row->DestinationPrefix.Prefix.si_family;
+    if (fam != AF_INET && fam != AF_INET6) return ERROR_INVALID_PARAMETER;
+    luid = row->InterfaceLuid;
+    if (!luid.Value && (!row->InterfaceIndex || ConvertInterfaceIndexToLuid( row->InterfaceIndex, &luid )))
+        return ERROR_FILE_NOT_FOUND;
+
+    if ((err = GetIpForwardTable2( fam, &table ))) return err;
+    err = ERROR_NOT_FOUND;
+    for (i = 0; i < table->NumEntries; i++)
+    {
+        entry = table->Table + i;
+        if (entry->InterfaceLuid.Value != luid.Value) continue;
+        if (entry->DestinationPrefix.PrefixLength != row->DestinationPrefix.PrefixLength) continue;
+        if (fam == AF_INET)
+        {
+            if (entry->DestinationPrefix.Prefix.Ipv4.sin_addr.s_addr != row->DestinationPrefix.Prefix.Ipv4.sin_addr.s_addr)
+                continue;
+            if (entry->NextHop.Ipv4.sin_addr.s_addr !=
+                (row->NextHop.si_family ? row->NextHop.Ipv4.sin_addr.s_addr : 0)) continue;
+        }
+        else
+        {
+            static const IN6_ADDR zero;
+            if (memcmp( &entry->DestinationPrefix.Prefix.Ipv6.sin6_addr, &row->DestinationPrefix.Prefix.Ipv6.sin6_addr,
+                        sizeof(IN6_ADDR) )) continue;
+            if (memcmp( &entry->NextHop.Ipv6.sin6_addr,
+                        row->NextHop.si_family ? &row->NextHop.Ipv6.sin6_addr : &zero, sizeof(IN6_ADDR) )) continue;
+        }
+        *row = *entry;
+        err = ERROR_SUCCESS;
+        break;
+    }
+    FreeMibTable( table );
+    return err;
+}
