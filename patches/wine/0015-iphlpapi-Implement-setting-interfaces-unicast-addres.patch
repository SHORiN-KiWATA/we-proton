+static BOOL ip_forward_exists( UINT fam, const void *key )
+{
+    UINT key_size = fam == AF_INET ? sizeof(struct nsi_ipv4_forward_key) : sizeof(struct nsi_ipv6_forward_key);
+    const NPI_MODULEID *module = fam == AF_INET ? &NPI_MS_IPV4_MODULEID : &NPI_MS_IPV6_MODULEID;
+    UINT count = 0, i;
+    BOOL ret = FALSE;
+    char *keys;
+
+    if (nsi_enumerate_all( 1, 0, module, NSI_IP_FORWARD_TABLE, NULL, 0, NULL, 0, NULL, 0, NULL, 0, &count ))
+        return FALSE;
+    if (!count || !(keys = malloc( count * key_size ))) return FALSE;
+    if (!nsi_enumerate_all( 1, 0, module, NSI_IP_FORWARD_TABLE, keys, key_size, NULL, 0, NULL, 0, NULL, 0, &count ))
+        for (i = 0; i < count && !ret; i++) ret = ip_forward_key_equal( fam, keys + i * key_size, key );
+    free( keys );
+    return ret;
+}
