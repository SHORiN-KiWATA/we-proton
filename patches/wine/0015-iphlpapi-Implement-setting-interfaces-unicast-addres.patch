+static NTSTATUS ip_interface_set( UINT fam, UINT action, const void *key, const void *rw_data )
+{
+    const struct nsi_ip_interface_key *ip_key = key;
+    const struct nsi_ip_interface_rw *rw = rw_data;
+    struct nsi_ndis_ifinfo_dynamic iface_dynamic;
+    struct netlink_request req;
+    unsigned int index;
+    NTSTATUS status;
+
+    if (action != NSI_SET_DEFAULT) return STATUS_NOT_SUPPORTED;
+    if ((status = luid_to_unix_index( &ip_key->luid, &index ))) return status;
+
+    if (rw->mtu && rw->mtu != ~0u &&
+        nsi_get_all_parameters( &NPI_MS_NDIS_MODULEID, NSI_NDIS_IFINFO_TABLE, (void *)&ip_key->luid,
+                                sizeof(ip_key->luid), NULL, 0, &iface_dynamic, sizeof(iface_dynamic), NULL, 0 ) &&
+        iface_dynamic.mtu != rw->mtu)
+    {
+        netlink_init( &req, RTM_NEWLINK, 0, sizeof(req.u.link) );
+        req.u.link.ifi_family = AF_UNSPEC;
+        req.u.link.ifi_index = index;
+        netlink_add_attr( &req, IFLA_MTU, &rw->mtu, sizeof(rw->mtu) );
+        if ((status = netlink_status( netlink_send( &req ) ))) return status;
+    }
+    if (rw->metric != ~0u) set_interface_metric( fam, &ip_key->luid, rw->metric );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS ip_unicast_set( UINT fam, UINT action, const void *key, const void *rw_data )
+{
+    const struct nsi_ipv4_unicast_key *key4 = key;
+    const struct nsi_ipv6_unicast_key *key6 = key;
+    const struct nsi_ip_unicast_rw *rw = rw_data;
+    const NET_LUID *luid = fam == AF_INET ? &key4->luid : &key6->luid;
+    const void *addr = fam == AF_INET ? (const void *)&key4->addr : (const void *)&key6->addr;
+    unsigned short addr_len = fam == AF_INET ? sizeof(key4->addr) : sizeof(key6->addr);
+    struct ifa_cacheinfo cache;
+    struct netlink_request req;
+    unsigned int index, prefix_len;
+    unsigned short flags;
+    NTSTATUS status;
+
+    if ((status = luid_to_unix_index( luid, &index ))) return status;
+
+    if (action == NSI_SET_DELETE || action == NSI_SET_DEFAULT)
+    {
+        netlink_init( &req, RTM_DELADDR, 0, sizeof(req.u.addr) );
+        req.u.addr.ifa_family = fam;
+        req.u.addr.ifa_index = index;
+        netlink_add_attr( &req, IFA_LOCAL, addr, addr_len );
+        if (fam == AF_INET6) netlink_add_attr( &req, IFA_ADDRESS, addr, addr_len );
+        status = netlink_status( netlink_send( &req ) );
+        if (status == STATUS_NOT_FOUND) status = STATUS_INVALID_PARAMETER;
+        if (status || action == NSI_SET_DELETE) return status;
+        flags = NLM_F_CREATE | NLM_F_EXCL;
+    }
+    else if (action == NSI_SET_CREATE_ONLY) flags = NLM_F_CREATE | NLM_F_EXCL;
+    else if (action == NSI_SET_CREATE_OR_SET) flags = NLM_F_CREATE | NLM_F_REPLACE;
+    else return STATUS_NOT_SUPPORTED;
+
+    prefix_len = rw->on_link_prefix;
+    if (prefix_len == 0xff || prefix_len == ~0u) prefix_len = IP_MAX_PREFIX_LEN( fam );
+    if (prefix_len > IP_MAX_PREFIX_LEN( fam )) return STATUS_INVALID_PARAMETER;
+
+    netlink_init( &req, RTM_NEWADDR, flags, sizeof(req.u.addr) );
+    req.u.addr.ifa_family = fam;
+    req.u.addr.ifa_prefixlen = prefix_len;
+    req.u.addr.ifa_scope = RT_SCOPE_UNIVERSE;
+    req.u.addr.ifa_index = index;
+    if (fam == AF_INET6) req.u.addr.ifa_flags = IFA_F_NODAD;
+    netlink_add_attr( &req, IFA_LOCAL, addr, addr_len );
+    netlink_add_attr( &req, IFA_ADDRESS, addr, addr_len );
+    if (rw->valid_lifetime != ~0u || rw->preferred_lifetime != ~0u)
+    {
+        memset( &cache, 0, sizeof(cache) );
+        cache.ifa_valid = rw->valid_lifetime;
+        cache.ifa_prefered = min( rw->preferred_lifetime, rw->valid_lifetime );
+        netlink_add_attr( &req, IFA_CACHEINFO, &cache, sizeof(cache) );
+    }
+    return netlink_status( netlink_send( &req ) );
+}
