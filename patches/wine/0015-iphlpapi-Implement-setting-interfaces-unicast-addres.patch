+static NTSTATUS ip_forward_set( UINT fam, UINT action, const void *key, const void *rw_data )
+{
+    const struct nsi_ipv4_forward_key *key4 = key;
+    const struct nsi_ipv6_forward_key *key6 = key;
+    const struct nsi_ip_forward_rw *rw = rw_data;
+    const NET_LUID *luid = fam == AF_INET ? &key4->luid : &key6->luid;
+    const void *prefix = fam == AF_INET ? (const void *)&key4->prefix : (const void *)&key6->prefix;
+    const void *next_hop = fam == AF_INET ? (const void *)&key4->next_hop : (const void *)&key6->next_hop;
+    unsigned short addr_len = fam == AF_INET ? sizeof(key4->prefix) : sizeof(key6->prefix);
+    unsigned int prefix_len = fam == AF_INET ? key4->prefix_len : key6->prefix_len;
+    static const BYTE zero[16];
+    BOOL has_next_hop = !!memcmp( next_hop, zero, addr_len );
+    struct netlink_request req;
+    unsigned int index, metric;
+    NTSTATUS status;
+    BOOL exists;
+
+    if (prefix_len > IP_MAX_PREFIX_LEN( fam )) return STATUS_INVALID_PARAMETER;
+    if ((status = luid_to_unix_index( luid, &index ))) return status;
+
+    exists = ip_forward_exists( fam, key );
+    if (action == NSI_SET_CREATE_ONLY && exists) return STATUS_DUPLICATE_OBJECTID;
+    if ((action == NSI_SET_DELETE || action == NSI_SET_DEFAULT) && !exists) return STATUS_NOT_FOUND;
+    if (action > NSI_SET_DELETE) return STATUS_NOT_SUPPORTED;
+
+    if (exists && action != NSI_SET_CREATE_ONLY)
+    {
+        netlink_init( &req, RTM_DELROUTE, 0, sizeof(req.u.route) );
+        req.u.route.rtm_family = fam;
+        req.u.route.rtm_dst_len = prefix_len;
+        req.u.route.rtm_table = RT_TABLE_MAIN;
+        req.u.route.rtm_scope = RT_SCOPE_NOWHERE;
+        if (prefix_len) netlink_add_attr( &req, RTA_DST, prefix, addr_len );
+        netlink_add_attr( &req, RTA_OIF, &index, sizeof(index) );
+        if (has_next_hop) netlink_add_attr( &req, RTA_GATEWAY, next_hop, addr_len );
+        if ((status = netlink_status( netlink_send( &req ) )) || action == NSI_SET_DELETE) return status;
+    }
+
+    netlink_init( &req, RTM_NEWROUTE, NLM_F_CREATE | NLM_F_EXCL, sizeof(req.u.route) );
+    req.u.route.rtm_family = fam;
+    req.u.route.rtm_dst_len = prefix_len;
+    req.u.route.rtm_table = RT_TABLE_MAIN;
+    req.u.route.rtm_protocol = RTPROT_STATIC;
+    req.u.route.rtm_scope = has_next_hop ? RT_SCOPE_UNIVERSE : RT_SCOPE_LINK;
+    req.u.route.rtm_type = RTN_UNICAST;
+    if (prefix_len) netlink_add_attr( &req, RTA_DST, prefix, addr_len );
+    netlink_add_attr( &req, RTA_OIF, &index, sizeof(index) );
+    if (has_next_hop) netlink_add_attr( &req, RTA_GATEWAY, next_hop, addr_len );
+    metric = rw->metric == ~0u ? 0 : rw->metric;
+    if (metric) netlink_add_attr( &req, RTA_PRIORITY, &metric, sizeof(metric) );
+    return netlink_status( netlink_send( &req ) );
+}
