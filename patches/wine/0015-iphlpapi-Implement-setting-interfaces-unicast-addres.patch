+/******************************************************************
+ *    InitializeIpInterfaceEntry (IPHLPAPI.@)
+ */
+void WINAPI InitializeIpInterfaceEntry( MIB_IPINTERFACE_ROW *row )
+{
+    TRACE( "%p.\n", row );
+
+    memset( row, 0, sizeof(*row) );
+    row->MaxReassemblySize = ~0u;
+    row->InterfaceIdentifier = ~(ULONG64)0;
+    row->MinRouterAdvertisementInterval = ~0u;
+    row->MaxRouterAdvertisementInterval = ~0u;
+    row->AdvertisingEnabled = row->ForwardingEnabled = row->WeakHostSend = row->WeakHostReceive = 0xff;
+    row->UseAutomaticMetric = row->UseNeighborUnreachabilityDetection = 0xff;
+    row->ManagedAddressConfigurationSupported = row->OtherStatefulConfigurationSupported = 0xff;
+    row->AdvertiseDefaultRoute = 0xff;
+    row->RouterDiscoveryBehavior = ~0u;
+    row->DadTransmits = ~0u;
+    row->LinkLocalAddressBehavior = ~0u;
+    row->LinkLocalAddressTimeout = ~0u;
+    memset( row->ZoneIndices, 0xff, sizeof(row->ZoneIndices) );
+    row->SitePrefixLength = ~0u;
+    row->Metric = ~0u;
+    row->Connected = row->SupportsWakeUpPatterns = row->SupportsNeighborDiscovery = row->SupportsRouterDiscovery = 0xff;
+    row->ReachableTime = ~0u;
+    row->DisableDefaultRoutes = 0xff;
+}
+
+/******************************************************************
+ *    InitializeUnicastIpAddressEntry (IPHLPAPI.@)
+ */
+void WINAPI InitializeUnicastIpAddressEntry( MIB_UNICASTIPADDRESS_ROW *row )
+{
+    TRACE( "%p.\n", row );
+
+    memset( row, 0, sizeof(*row) );
+    row->PrefixOrigin = IpPrefixOriginUnchanged;
+    row->SuffixOrigin = IpSuffixOriginUnchanged;
+    row->ValidLifetime = ~0u;
+    row->PreferredLifetime = ~0u;
+    row->OnLinkPrefixLength = 0xff;
+}
+
+/******************************************************************
+ *    InitializeIpForwardEntry (IPHLPAPI.@)
+ */
+void WINAPI InitializeIpForwardEntry( MIB_IPFORWARD_ROW2 *row )
+{
+    TRACE( "%p.\n", row );
+
+    memset( row, 0, sizeof(*row) );
+    row->SitePrefixLength = 0xff;
+    row->ValidLifetime = ~0u;
+    row->PreferredLifetime = ~0u;
+    row->Metric = ~0u;
+    row->Protocol = ~0u;
+    row->Loopback = row->AutoconfigureAddress = row->Publish = row->Immortal = 0xff;
+}
+
+static DWORD get_row_luid( NET_LUID *luid, NET_IFINDEX index )
+{
+    if (luid->Value) return ERROR_SUCCESS;
+    if (!index || ConvertInterfaceIndexToLuid( index, luid )) return ERROR_FILE_NOT_FOUND;
+    return ERROR_SUCCESS;
+}
+
+/******************************************************************
+ *    SetIpInterfaceEntry (IPHLPAPI.@)
+ */
+DWORD WINAPI SetIpInterfaceEntry( MIB_IPINTERFACE_ROW *row )
+{
+    struct nsi_ip_interface_key key;
+    struct nsi_ip_interface_rw rw;
+
+    TRACE( "%p.\n", row );
+
+    if (!row) return ERROR_INVALID_PARAMETER;
+    if (row->Family != AF_INET && row->Family != AF_INET6) return ERROR_INVALID_PARAMETER;
+    key.luid = row->InterfaceLuid;
+    if (!key.luid.Value && (!row->InterfaceIndex || ConvertInterfaceIndexToLuid( row->InterfaceIndex, &key.luid )))
+        return ERROR_INVALID_PARAMETER;
+    if (row->SitePrefixLength != ~0u && row->SitePrefixLength > (row->Family == AF_INET ? 32 : 128))
+        return ERROR_INVALID_PARAMETER;
+
+    memset( &rw, 0, sizeof(rw) );
+    rw.metric = row->UseAutomaticMetric == TRUE ? ~0u : row->Metric;
+    rw.mtu = row->NlMtu;
+    rw.site_prefix_len = row->SitePrefixLength;
+    return NsiSetAllParameters( 1, NSI_SET_DEFAULT, ip_module_id( row->Family ), NSI_IP_INTERFACE_TABLE,
+                                &key, sizeof(key), &rw, sizeof(rw) );
+}
+
+static DWORD set_unicast_entry( const MIB_UNICASTIPADDRESS_ROW *row, DWORD action )
+{
+    struct nsi_ipv4_unicast_key key4;
+    struct nsi_ipv6_unicast_key key6;
+    struct nsi_ip_unicast_rw rw;
+    NET_LUID luid;
+    DWORD err, key_size;
+    void *key;
+
+    if (!row) return ERROR_INVALID_PARAMETER;
+    if (row->Address.si_family != AF_INET && row->Address.si_family != AF_INET6) return ERROR_INVALID_PARAMETER;
+    luid = row->InterfaceLuid;
+    if ((err = get_row_luid( &luid, row->InterfaceIndex ))) return err;
+    if (row->OnLinkPrefixLength != 0xff && row->OnLinkPrefixLength > (row->Address.si_family == AF_INET ? 32 : 128))
+        return ERROR_INVALID_PARAMETER;
+
+    if (row->Address.si_family == AF_INET)
+    {
+        key4.luid = luid;
+        key4.addr = row->Address.Ipv4.sin_addr;
+        key4.pad = 0;
+        key = &key4;
+        key_size = sizeof(key4);
+    }
+    else
+    {
+        key6.luid = luid;
+        key6.addr = row->Address.Ipv6.sin6_addr;
+        key = &key6;
+        key_size = sizeof(key6);
+    }
+
+    memset( &rw, 0, sizeof(rw) );
+    rw.preferred_lifetime = row->PreferredLifetime;
+    rw.valid_lifetime = row->ValidLifetime;
+    rw.prefix_origin = row->PrefixOrigin == IpPrefixOriginUnchanged ? IpPrefixOriginManual : row->PrefixOrigin;
+    rw.suffix_origin = row->SuffixOrigin == IpSuffixOriginUnchanged ? IpSuffixOriginManual : row->SuffixOrigin;
+    rw.on_link_prefix = row->OnLinkPrefixLength;
+    return NsiSetAllParameters( 1, action, ip_module_id( row->Address.si_family ), NSI_IP_UNICAST_TABLE,
+                                key, key_size, &rw, sizeof(rw) );
+}
+
+/******************************************************************
+ *    CreateUnicastIpAddressEntry (IPHLPAPI.@)
+ */
+DWORD WINAPI CreateUnicastIpAddressEntry( const MIB_UNICASTIPADDRESS_ROW *row )
+{
+    TRACE( "%p.\n", row );
+    return set_unicast_entry( row, NSI_SET_CREATE_ONLY );
+}
+
+/******************************************************************
+ *    SetUnicastIpAddressEntry (IPHLPAPI.@)
+ */
+DWORD WINAPI SetUnicastIpAddressEntry( const MIB_UNICASTIPADDRESS_ROW *row )
+{
+    TRACE( "%p.\n", row );
+    return set_unicast_entry( row, NSI_SET_DEFAULT );
+}
+
+/******************************************************************
+ *    DeleteUnicastIpAddressEntry (IPHLPAPI.@)
+ */
+DWORD WINAPI DeleteUnicastIpAddressEntry( const MIB_UNICASTIPADDRESS_ROW *row )
+{
+    TRACE( "%p.\n", row );
+    return set_unicast_entry( row, NSI_SET_DELETE );
+}
+
+static BOOL prefix_has_host_bits( const SOCKADDR_INET *prefix, UINT len )
+{
+    const BYTE *addr;
+    UINT i, size;
+
+    if (prefix->si_family == AF_INET)
+    {
+        addr = (const BYTE *)&prefix->Ipv4.sin_addr;
+        size = 4;
+    }
+    else
+    {
+        addr = (const BYTE *)&prefix->Ipv6.sin6_addr;
+        size = 16;
+    }
+    for (i = len / 8; i < size; i++)
+    {
+        BYTE mask = (i == len / 8 && len % 8) ? (0xff >> (len % 8)) : 0xff;
+        if (addr[i] & mask) return TRUE;
+    }
+    return FALSE;
+}
+
+static DWORD set_forward_entry( const MIB_IPFORWARD_ROW2 *row, DWORD action )
+{
+    struct nsi_ipv4_forward_key key4;
+    struct nsi_ipv6_forward_key key6;
+    struct nsi_ip_forward_rw rw;
+    USHORT fam;
+    NET_LUID luid;
+    DWORD err, key_size;
+    void *key;
+
+    if (!row) return ERROR_INVALID_PARAMETER;
+    fam = row->DestinationPrefix.Prefix.si_family;
+    if (fam != AF_INET && fam != AF_INET6) return ERROR_INVALID_PARAMETER;
+    if (row->NextHop.si_family && row->NextHop.si_family != fam) return ERROR_INVALID_PARAMETER;
+    if (row->DestinationPrefix.PrefixLength > (fam == AF_INET ? 32 : 128)) return ERROR_INVALID_PARAMETER;
+    if (prefix_has_host_bits( &row->DestinationPrefix.Prefix, row->DestinationPrefix.PrefixLength ))
+        return ERROR_INVALID_PARAMETER;
+    luid = row->InterfaceLuid;
+    if ((err = get_row_luid( &luid, row->InterfaceIndex ))) return err;
+
+    if (fam == AF_INET)
+    {
+        memset( &key4, 0, sizeof(key4) );
+        key4.prefix = row->DestinationPrefix.Prefix.Ipv4.sin_addr;
+        key4.prefix_len = row->DestinationPrefix.PrefixLength;
+        key4.luid = luid;
+        key4.luid2 = luid;
+        if (row->NextHop.si_family) key4.next_hop = row->NextHop.Ipv4.sin_addr;
+        key = &key4;
+        key_size = sizeof(key4);
+    }
+    else
+    {
+        memset( &key6, 0, sizeof(key6) );
+        key6.prefix = row->DestinationPrefix.Prefix.Ipv6.sin6_addr;
+        key6.prefix_len = row->DestinationPrefix.PrefixLength;
+        key6.luid = luid;
+        key6.luid2 = luid;
+        if (row->NextHop.si_family) key6.next_hop = row->NextHop.Ipv6.sin6_addr;
+        key = &key6;
+        key_size = sizeof(key6);
+    }
+
+    memset( &rw, 0, sizeof(rw) );
+    rw.site_prefix_len = row->SitePrefixLength;
+    rw.valid_lifetime = row->ValidLifetime;
+    rw.preferred_lifetime = row->PreferredLifetime;
+    rw.metric = row->Metric;
+    rw.protocol = row->Protocol;
+    rw.loopback = row->Loopback;
+    rw.autoconf = row->AutoconfigureAddress;
+    rw.publish = row->Publish;
+    rw.immortal = row->Immortal;
+    return NsiSetAllParameters( 1, action, ip_module_id( fam ), NSI_IP_FORWARD_TABLE,
+                                key, key_size, &rw, sizeof(rw) );
+}
+
+/******************************************************************
+ *    CreateIpForwardEntry2 (IPHLPAPI.@)
+ */
+DWORD WINAPI CreateIpForwardEntry2( const MIB_IPFORWARD_ROW2 *row )
+{
+    TRACE( "%p.\n", row );
+    return set_forward_entry( row, NSI_SET_CREATE_ONLY );
+}
+
+/******************************************************************
+ *    SetIpForwardEntry2 (IPHLPAPI.@)
+ */
+DWORD WINAPI SetIpForwardEntry2( const MIB_IPFORWARD_ROW2 *row )
+{
+    TRACE( "%p.\n", row );
+    return set_forward_entry( row, NSI_SET_DEFAULT );
+}
+
+/******************************************************************
+ *    DeleteIpForwardEntry2 (IPHLPAPI.@)
+ */
+DWORD WINAPI DeleteIpForwardEntry2( const MIB_IPFORWARD_ROW2 *row )
+{
+    TRACE( "%p.\n", row );
+    return set_forward_entry( row, NSI_SET_DELETE );
+}
