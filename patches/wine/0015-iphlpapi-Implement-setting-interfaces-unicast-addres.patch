+#ifdef HAVE_LINUX_RTNETLINK_H
+
+struct netlink_request
+{
+    struct nlmsghdr hdr;
+    union
+    {
+        struct ifinfomsg link;
+        struct ifaddrmsg addr;
+        struct rtmsg route;
+    } u;
+    char attrs[256];
+};
+
+static void netlink_init( struct netlink_request *req, unsigned short type, unsigned short flags, size_t len )
+{
+    memset( req, 0, sizeof(*req) );
+    req->hdr.nlmsg_len = NLMSG_LENGTH( len );
+    req->hdr.nlmsg_type = type;
+    req->hdr.nlmsg_flags = NLM_F_REQUEST | NLM_F_ACK | flags;
+}
+
+static void netlink_add_attr( struct netlink_request *req, unsigned short type, const void *data, unsigned short len )
+{
+    struct rtattr *rta = (struct rtattr *)((char *)req + NLMSG_ALIGN( req->hdr.nlmsg_len ));
+
+    rta->rta_type = type;
+    rta->rta_len = RTA_LENGTH( len );
+    memcpy( RTA_DATA( rta ), data, len );
+    req->hdr.nlmsg_len = NLMSG_ALIGN( req->hdr.nlmsg_len ) + RTA_ALIGN( rta->rta_len );
+}
+
+/* send a request and wait for its acknowledgement; returns 0 or an errno value */
+static int netlink_send( struct netlink_request *req )
+{
+    static unsigned int seq;
+    struct sockaddr_nl addr;
+    char buffer[4096];
+    struct nlmsghdr *nlh;
+    int fd, len, ret = EIO;
+
+    if ((fd = socket( PF_NETLINK, SOCK_RAW | SOCK_CLOEXEC, NETLINK_ROUTE )) == -1) return errno;
+
+    memset( &addr, 0, sizeof(addr) );
+    addr.nl_family = AF_NETLINK;
+    req->hdr.nlmsg_seq = __atomic_add_fetch( &seq, 1, __ATOMIC_RELAXED );
+    if (sendto( fd, &req->hdr, req->hdr.nlmsg_len, 0, (struct sockaddr *)&addr, sizeof(addr) ) == -1)
+    {
+        ret = errno;
+        goto done;
+    }
+
+    for (;;)
+    {
+        if ((len = recv( fd, buffer, sizeof(buffer), 0 )) == -1)
+        {
+            if (errno == EINTR) continue;
+            ret = errno;
+            goto done;
+        }
+        for (nlh = (struct nlmsghdr *)buffer; NLMSG_OK( nlh, len ); nlh = NLMSG_NEXT( nlh, len ))
+        {
+            if (nlh->nlmsg_seq != req->hdr.nlmsg_seq || nlh->nlmsg_type != NLMSG_ERROR) continue;
+            ret = -((struct nlmsgerr *)NLMSG_DATA( nlh ))->error;
+            goto done;
+        }
+    }
+
+done:
+    close( fd );
+    return ret;
+}
+
+static NTSTATUS netlink_status( int err )
+{
+    switch (err)
+    {
+    case 0:             return STATUS_SUCCESS;
+    case EPERM:
+    case EACCES:        return STATUS_ACCESS_DENIED;
+    case EEXIST:        return STATUS_DUPLICATE_OBJECTID;
+    case ENODEV:
+    case ESRCH:
+    case ENOENT:        return STATUS_NOT_FOUND;
+    case ENETUNREACH:   return STATUS_NETWORK_UNREACHABLE;
+    case ENOMEM:
+    case ENOBUFS:       return STATUS_NO_MEMORY;
+    default:            return STATUS_INVALID_PARAMETER;
+    }
+}
