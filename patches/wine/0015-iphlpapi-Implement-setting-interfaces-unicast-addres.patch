+static NTSTATUS nsiproxy_set_all_parameters( IRP *irp )
+{
+    IO_STACK_LOCATION *irpsp = IoGetCurrentIrpStackLocation( irp );
+    struct nsiproxy_set_all_parameters *in = (struct nsiproxy_set_all_parameters *)irp->AssociatedIrp.SystemBuffer;
+    DWORD in_len = irpsp->Parameters.DeviceIoControl.InputBufferLength;
+    struct nsi_set_all_parameters_ex set_all;
+
+    if (in_len < offsetof(struct nsiproxy_set_all_parameters, data[0]) ||
+        in_len < offsetof(struct nsiproxy_set_all_parameters, data[in->key_size + in->rw_size]))
+        return STATUS_INVALID_PARAMETER;
+
+    set_all.unknown[0] = 0;
+    set_all.unknown[1] = 0;
+    set_all.first_arg = in->first_arg;
+    set_all.action = in->action;
+    set_all.module = &in->module;
+    set_all.table = in->table;
+    set_all.key = in->data;
+    set_all.key_size = in->key_size;
+    set_all.rw_data = in->rw_size ? in->data + in->key_size : NULL;
+    set_all.rw_size = in->rw_size;
+
+    irp->IoStatus.Information = 0;
+    return nsiproxy_call( nsi_set_all_parameters_ex, &set_all );
+}
