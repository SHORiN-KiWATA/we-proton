+/* Changing interfaces, addresses and routes. */
+
+#define IP_MAX_PREFIX_LEN(fam) ((fam) == AF_INET ? 32 : 128)
+
+/* Linux has no interface metric; remember the one that was set so that it can be read back. */
+static struct
+{
+    NET_LUID luid;
+    UINT fam;
+    ULONG metric;
+} interface_metrics[64];
+static unsigned int interface_metric_count;
+static pthread_mutex_t interface_metric_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static BOOL get_interface_metric( UINT fam, const NET_LUID *luid, ULONG *metric )
+{
+    unsigned int i;
+    BOOL ret = FALSE;
+
+    pthread_mutex_lock( &interface_metric_lock );
+    for (i = 0; i < interface_metric_count; i++)
+    {
+        if (interface_metrics[i].fam != fam || interface_metrics[i].luid.Value != luid->Value) continue;
+        *metric = interface_metrics[i].metric;
+        ret = TRUE;
+        break;
+    }
+    pthread_mutex_unlock( &interface_metric_lock );
+    return ret;
+}
+
+static void set_interface_metric( UINT fam, const NET_LUID *luid, ULONG metric )
+{
+    unsigned int i;
+
+    pthread_mutex_lock( &interface_metric_lock );
+    for (i = 0; i < interface_metric_count; i++)
+        if (interface_metrics[i].fam == fam && interface_metrics[i].luid.Value == luid->Value) break;
+    if (i < ARRAY_SIZE(interface_metrics))
+    {
+        interface_metrics[i].luid = *luid;
+        interface_metrics[i].fam = fam;
+        interface_metrics[i].metric = metric;
+        if (i == interface_metric_count) interface_metric_count++;
+    }
+    pthread_mutex_unlock( &interface_metric_lock );
+}
+
+static NTSTATUS luid_to_unix_index( const NET_LUID *luid, unsigned int *index )
+{
+    const char *unix_name;
+
+    if (!convert_luid_to_unix_name( luid, &unix_name )) return STATUS_NOT_FOUND;
+    if (!(*index = if_nametoindex( unix_name ))) return STATUS_NOT_FOUND;
+    return STATUS_SUCCESS;
+}
