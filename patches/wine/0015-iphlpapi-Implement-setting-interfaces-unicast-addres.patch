+DWORD WINAPI NsiSetAllParameters( DWORD unk, DWORD action, const NPI_MODULEID *module, DWORD table,
+                                  const void *key, DWORD key_size, const void *rw_data, DWORD rw_size )
+{
+    struct nsi_set_all_parameters_ex params;
+
+    TRACE( "%ld %ld %p %ld %p %ld %p %ld\n", unk, action, module, table, key, key_size, rw_data, rw_size );
+
+    params.unknown[0] = 0;
+    params.unknown[1] = 0;
+    params.module = module;
+    params.table = table;
+    params.first_arg = unk;
+    params.action = action;
+    params.key = key;
+    params.key_size = key_size;
+    params.rw_data = rw_data;
+    params.rw_size = rw_size;
+
+    return NsiSetAllParametersEx( &params );
+}
+
+DWORD WINAPI NsiSetAllParametersEx( struct nsi_set_all_parameters_ex *params )
+{
+    HANDLE device = get_nsi_device( FALSE );
+    struct nsiproxy_set_all_parameters *in;
+    ULONG in_size = FIELD_OFFSET( struct nsiproxy_set_all_parameters, data[params->key_size + params->rw_size] );
+    DWORD err = ERROR_SUCCESS, received;
+
+    if (device == INVALID_HANDLE_VALUE) return GetLastError();
+
+    if (!(in = malloc( in_size ))) return ERROR_OUTOFMEMORY;
+    in->module = *params->module;
+    in->first_arg = params->first_arg;
+    in->action = params->action;
+    in->table = params->table;
+    in->key_size = params->key_size;
+    in->rw_size = params->rw_size;
+    memcpy( in->data, params->key, params->key_size );
+    if (params->rw_size) memcpy( in->data + params->key_size, params->rw_data, params->rw_size );
+
+    if (!DeviceIoControl( device, IOCTL_NSIPROXY_WINE_SET_ALL_PARAMETERS, in, in_size, NULL, 0, &received, NULL ))
+        err = GetLastError();
+
+    free( in );
+    return err;
+}
