+static BOOL ip_forward_key_equal( UINT fam, const void *key1, const void *key2 )
+{
+    if (fam == AF_INET)
+    {
+        const struct nsi_ipv4_forward_key *a = key1, *b = key2;
+        return a->prefix.WS_s_addr == b->prefix.WS_s_addr && a->prefix_len == b->prefix_len &&
+               a->luid.Value == b->luid.Value && a->next_hop.WS_s_addr == b->next_hop.WS_s_addr;
+    }
+    else
+    {
+        const struct nsi_ipv6_forward_key *a = key1, *b = key2;
+        return !memcmp( &a->prefix, &b->prefix, sizeof(a->prefix) ) && a->prefix_len == b->prefix_len &&
+               a->luid.Value == b->luid.Value && !memcmp( &a->next_hop, &b->next_hop, sizeof(a->next_hop) );
+    }
+}
