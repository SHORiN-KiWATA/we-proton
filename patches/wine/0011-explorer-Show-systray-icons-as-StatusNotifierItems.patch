+
+/* render the icon as straight ARGB in network byte order, the format StatusNotifierItem uses */
+static BOOL get_icon_pixels( HICON image, int size, BYTE *pixels )
+{
+    unsigned int width_bytes = (size + 31) / 32 * 4;
+    BITMAPINFO *info;
+    HBITMAP dib = 0, mask = 0;
+    void *color_bits, *mask_bits;
+    BOOL has_alpha = FALSE, ret = FALSE;
+    HDC hdc;
+    int i, x, y;
+    DWORD *ptr;
+
+    if (!(info = calloc( 1, FIELD_OFFSET( BITMAPINFO, bmiColors[2] ) ))) return FALSE;
+    info->bmiHeader.biSize = sizeof(info->bmiHeader);
+    info->bmiHeader.biWidth = size;
+    info->bmiHeader.biHeight = -size;
+    info->bmiHeader.biBitCount = 32;
+    info->bmiHeader.biPlanes = 1;
+    info->bmiHeader.biCompression = BI_RGB;
+
+    hdc = CreateCompatibleDC( 0 );
+    if (!(dib = CreateDIBSection( 0, info, DIB_RGB_COLORS, &color_bits, NULL, 0 ))) goto done;
+    SelectObject( hdc, dib );
+    DrawIconEx( hdc, 0, 0, image, size, size, 0, 0, DI_NORMAL );
+
+    /* check if the icon was drawn with an alpha channel */
+    for (i = 0, ptr = color_bits; i < size * size; i++)
+        if ((has_alpha = (ptr[i] & 0xff000000) != 0)) break;
+
+    if (!has_alpha)
+    {
+        info->bmiHeader.biBitCount = 1;
+        info->bmiColors[1].rgbRed = 0xff;
+        info->bmiColors[1].rgbGreen = 0xff;
+        info->bmiColors[1].rgbBlue = 0xff;
+
+        if (!(mask = CreateDIBSection( 0, info, DIB_RGB_COLORS, &mask_bits, NULL, 0 ))) goto done;
+        memset( mask_bits, 0xff, width_bytes * size );
+        SelectObject( hdc, mask );
+        DrawIconEx( hdc, 0, 0, image, size, size, 0, 0, DI_MASK );
+
+        for (y = 0, ptr = color_bits; y < size; y++)
+            for (x = 0; x < size; x++, ptr++)
+                if (!((((BYTE *)mask_bits)[y * width_bytes + x / 8] << (x % 8)) & 0x80))
+                    *ptr |= 0xff000000;
+    }
+
+    /* the drawn colors are premultiplied by alpha */
+    for (i = 0, ptr = color_bits; i < size * size; i++, pixels += 4)
+    {
+        BYTE alpha = ptr[i] >> 24, red = ptr[i] >> 16, green = ptr[i] >> 8, blue = ptr[i];
+
+        if (alpha && alpha != 0xff)
+        {
+            red = min( 0xff, red * 0xff / alpha );
+            green = min( 0xff, green * 0xff / alpha );
+            blue = min( 0xff, blue * 0xff / alpha );
+        }
+        pixels[0] = alpha;
+        pixels[1] = red;
+        pixels[2] = green;
+        pixels[3] = blue;
+    }
+    ret = TRUE;
+
+done:
+    free( info );
+    DeleteDC( hdc );
+    if (dib) DeleteObject( dib );
+    if (mask) DeleteObject( mask );
+    return ret;
+}
