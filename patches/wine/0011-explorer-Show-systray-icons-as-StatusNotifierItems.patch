+/* add or update the StatusNotifierItem of an icon */
+static NTSTATUS sni_set_item( struct icon *icon, unsigned int code )
+{
+    static const UINT sizes[SNI_MAX_SIZES] = { 16, 24, 32, 48 };
+    struct sni_icon_params params = {.hwnd = (ULONG_PTR)icon->window};
+    char *app = get_icon_app_name( icon ), *tooltip = strdup_utf8( icon->tiptext );
+    unsigned int i, total = 0;
+    NTSTATUS status;
+    BYTE *pixels;
+
+    for (i = 0; i < ARRAY_SIZE(sizes); i++) total += sizes[i] * sizes[i] * 4;
+    if ((pixels = malloc( total )))
+    {
+        for (i = 0, total = 0; icon->image && i < ARRAY_SIZE(sizes); i++)
+        {
+            if (!get_icon_pixels( icon->image, sizes[i], pixels + total )) break;
+            params.sizes[i] = sizes[i];
+            total += sizes[i] * sizes[i] * 4;
+        }
+    }
+
+    params.id = (ULONG_PTR)app;
+    params.title = (ULONG_PTR)(tooltip && tooltip[0] ? tooltip : app);
+    params.tooltip = (ULONG_PTR)tooltip;
+    params.pixels = (ULONG_PTR)pixels;
+    status = WINE_UNIX_CALL( code, &params );
+
+    free( app );
+    free( tooltip );
+    free( pixels );
+    return status;
+}
