+#ifndef __WINE_EXPLORER_UNIXLIB_H
+#define __WINE_EXPLORER_UNIXLIB_H
+
+#include "wine/unixlib.h"
+
+/* Pointers are passed as UINT64, so 32-bit and 64-bit callers use the same layout. */
+
+#define SNI_MAX_SIZES 4
+
+struct sni_icon_params
+{
+    UINT64 hwnd;     /* the icon window, identifies the item */
+    UINT64 id;       /* const char *, UTF-8: the application, the same across runs */
+    UINT64 title;    /* const char *, UTF-8 */
+    UINT64 tooltip;  /* const char *, UTF-8 */
+    UINT64 pixels;   /* const UINT *: ARGB in network byte order, the images one after another */
+    UINT   sizes[SNI_MAX_SIZES];  /* width (and height) of each image, 0 ends the list */
+};
+
+struct sni_remove_params
+{
+    UINT64 hwnd;
+};
+
+enum sni_event_type
+{
+    SNI_EVENT_ACTIVATE,
+    SNI_EVENT_SECONDARY_ACTIVATE,
+    SNI_EVENT_CONTEXT_MENU,
+};
+
+struct sni_event_params
+{
+    UINT64 hwnd;     /* out: the icon window */
+    UINT   type;     /* out: enum sni_event_type */
+    INT    x;        /* out: where the host says the item was clicked */
+    INT    y;
+};
+
+struct sni_notify_params
+{
+    UINT64 app;      /* const char *, UTF-8 */
+    UINT64 title;    /* const char *, UTF-8 */
+    UINT64 text;     /* const char *, UTF-8 */
+    INT    timeout;  /* in milliseconds */
+};
+
+enum sni_funcs
+{
+    unix_sni_init,
+    unix_sni_add_item,
+    unix_sni_update_item,
+    unix_sni_remove_item,
+    unix_sni_wait_event,
+    unix_sni_notify,
+    unix_sni_funcs_count,
+};
+
+#endif /* __WINE_EXPLORER_UNIXLIB_H */
