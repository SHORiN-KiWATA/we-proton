+/* turn a click reported by the StatusNotifierItem host into the mouse messages a docked icon gets */
+static void handle_sni_event( struct icon *icon, UINT type, POINT pt )
+{
+    HWND hwnd = icon->window;
+    DWORD now = GetTickCount();
+    UINT down, up, buttons;
+    LPARAM lparam;
+
+    TRACE( "id=0x%x, hwnd=%p, type %u at %s\n", icon->id, icon->owner, type, wine_dbgstr_point( &pt ));
+
+    /* the click happened on the icon, so that is where the cursor is; the host
+     * counts from the top left corner of the desktop, not of the primary monitor */
+    if (pt.x || pt.y)
+    {
+        pt.x += GetSystemMetrics( SM_XVIRTUALSCREEN );
+        pt.y += GetSystemMetrics( SM_YVIRTUALSCREEN );
+        SetCursorPos( pt.x, pt.y );
+    }
+    else GetCursorPos( &pt );
+    ScreenToClient( hwnd, &pt );
+    lparam = MAKELPARAM( pt.x, pt.y );
+
+    switch (type)
+    {
+    case SNI_EVENT_ACTIVATE:
+        if (icon->last_click && now - icon->last_click <= GetDoubleClickTime())
+        {
+            /* some hosts report the second click of a double click twice, as a click and as a double click */
+            if (icon->double_click) return;
+            icon->double_click = TRUE;
+            icon->last_click = now;
+            SendMessageW( hwnd, WM_LBUTTONDBLCLK, MK_LBUTTON, lparam );
+            SendMessageW( hwnd, WM_LBUTTONUP, 0, lparam );
+            return;
+        }
+        icon->last_click = now;
+        icon->double_click = FALSE;
+        down = WM_LBUTTONDOWN;
+        up = WM_LBUTTONUP;
+        buttons = MK_LBUTTON;
+        break;
+    case SNI_EVENT_SECONDARY_ACTIVATE:
+        down = WM_MBUTTONDOWN;
+        up = WM_MBUTTONUP;
+        buttons = MK_MBUTTON;
+        break;
+    case SNI_EVENT_CONTEXT_MENU:
+        down = WM_RBUTTONDOWN;
+        up = WM_RBUTTONUP;
+        buttons = MK_RBUTTON;
+        break;
+    default:
+        return;
+    }
+
+    /* the icon is deleted if the owner window is gone, only use hwnd from here */
+    SendMessageW( hwnd, down, buttons, lparam );
+    SendMessageW( hwnd, up, 0, lparam );
+}
