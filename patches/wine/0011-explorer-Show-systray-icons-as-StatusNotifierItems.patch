+#define DBUS_FUNCS \
+    DO_FUNC(dbus_bus_add_match); \
+    DO_FUNC(dbus_bus_get_private); \
+    DO_FUNC(dbus_bus_name_has_owner); \
+    DO_FUNC(dbus_bus_request_name); \
+    DO_FUNC(dbus_connection_close); \
+    DO_FUNC(dbus_connection_flush); \
+    DO_FUNC(dbus_connection_get_is_connected); \
+    DO_FUNC(dbus_connection_get_unix_fd); \
+    DO_FUNC(dbus_connection_pop_message); \
+    DO_FUNC(dbus_connection_read_write); \
+    DO_FUNC(dbus_connection_send); \
+    DO_FUNC(dbus_connection_set_exit_on_disconnect); \
+    DO_FUNC(dbus_connection_unref); \
+    DO_FUNC(dbus_error_free); \
+    DO_FUNC(dbus_error_init); \
+    DO_FUNC(dbus_message_append_args); \
+    DO_FUNC(dbus_message_get_args); \
+    DO_FUNC(dbus_message_get_interface); \
+    DO_FUNC(dbus_message_get_member); \
+    DO_FUNC(dbus_message_get_no_reply); \
+    DO_FUNC(dbus_message_get_path); \
+    DO_FUNC(dbus_message_get_type); \
+    DO_FUNC(dbus_message_is_method_call); \
+    DO_FUNC(dbus_message_is_signal); \
+    DO_FUNC(dbus_message_iter_append_basic); \
+    DO_FUNC(dbus_message_iter_append_fixed_array); \
+    DO_FUNC(dbus_message_iter_close_container); \
+    DO_FUNC(dbus_message_iter_init_append); \
+    DO_FUNC(dbus_message_iter_open_container); \
+    DO_FUNC(dbus_message_new_error); \
+    DO_FUNC(dbus_message_new_method_call); \
+    DO_FUNC(dbus_message_new_method_return); \
+    DO_FUNC(dbus_message_new_signal); \
+    DO_FUNC(dbus_message_set_no_reply); \
+    DO_FUNC(dbus_message_unref); \
+    DO_FUNC(dbus_threads_init_default)
+
+#define DO_FUNC(f) static typeof(f) * p_##f
+DBUS_FUNCS;
+#undef DO_FUNC
+
+static const char watcher_name[] = "org.kde.StatusNotifierWatcher";
+static const char watcher_path[] = "/StatusNotifierWatcher";
+static const char item_interface[] = "org.kde.StatusNotifierItem";
+static const char item_path[] = "/StatusNotifierItem";
+
+static const char introspection_xml[] =
+    DBUS_INTROSPECT_1_0_XML_DOCTYPE_DECL_NODE
+    "<node>\n"
+    " <interface name=\"org.kde.StatusNotifierItem\">\n"
+    "  <property name=\"Category\" type=\"s\" access=\"read\"/>\n"
+    "  <property name=\"Id\" type=\"s\" access=\"read\"/>\n"
+    "  <property name=\"Title\" type=\"s\" access=\"read\"/>\n"
+    "  <property name=\"Status\" type=\"s\" access=\"read\"/>\n"
+    "  <property name=\"WindowId\" type=\"i\" access=\"read\"/>\n"
+    "  <property name=\"IconName\" type=\"s\" access=\"read\"/>\n"
+    "  <property name=\"IconPixmap\" type=\"a(iiay)\" access=\"read\"/>\n"
+    "  <property name=\"OverlayIconName\" type=\"s\" access=\"read\"/>\n"
+    "  <property name=\"AttentionIconName\" type=\"s\" access=\"read\"/>\n"
+    "  <property name=\"ToolTip\" type=\"(sa(iiay)ss)\" access=\"read\"/>\n"
+    "  <property name=\"ItemIsMenu\" type=\"b\" access=\"read\"/>\n"
+    "  <method name=\"ContextMenu\"><arg name=\"x\" type=\"i\"/><arg name=\"y\" type=\"i\"/></method>\n"
+    "  <method name=\"Activate\"><arg name=\"x\" type=\"i\"/><arg name=\"y\" type=\"i\"/></method>\n"
+    "  <method name=\"SecondaryActivate\"><arg name=\"x\" type=\"i\"/><arg name=\"y\" type=\"i\"/></method>\n"
+    "  <method name=\"Scroll\"><arg name=\"delta\" type=\"i\"/><arg name=\"orientation\" type=\"s\"/></method>\n"
+    "  <signal name=\"NewTitle\"/>\n"
+    "  <signal name=\"NewIcon\"/>\n"
+    "  <signal name=\"NewToolTip\"/>\n"
+    " </interface>\n"
+    " <interface name=\"org.freedesktop.DBus.Properties\">\n"
+    "  <method name=\"Get\"><arg name=\"interface\" type=\"s\" direction=\"in\"/>"
+    "<arg name=\"name\" type=\"s\" direction=\"in\"/><arg name=\"value\" type=\"v\" direction=\"out\"/></method>\n"
+    "  <method name=\"GetAll\"><arg name=\"interface\" type=\"s\" direction=\"in\"/>"
+    "<arg name=\"values\" type=\"a{sv}\" direction=\"out\"/></method>\n"
+    " </interface>\n"
+    " <interface name=\"org.freedesktop.DBus.Introspectable\">\n"
+    "  <method name=\"Introspect\"><arg name=\"xml\" type=\"s\" direction=\"out\"/></method>\n"
+    " </interface>\n"
+    "</node>\n";
+
+static const char *const property_names[] =
+{
+    "Category", "Id", "Title", "Status", "WindowId", "IconName", "IconPixmap",
+    "OverlayIconName", "AttentionIconName", "ToolTip", "ItemIsMenu",
+};
+
+/* Every item has its own connection and well-known name, like other implementations
+ * of the protocol do: the host finds the item by that name, and the item goes away
+ * from the host when the connection is closed. */
+struct sni_item
+{
+    struct list     entry;
+    UINT64          hwnd;
+    DBusConnection *connection;
+    char            name[64];
+    char           *id;
+    char           *title;
+    char           *tooltip;
+    UINT           *pixels;
+    UINT            sizes[SNI_MAX_SIZES];
+};
+
+static inline const void *param_ptr( UINT64 ptr )
+{
+    return (const void *)(ULONG_PTR)ptr;
+}
+
+static struct list items = LIST_INIT( items );
+static pthread_mutex_t items_mutex = PTHREAD_MUTEX_INITIALIZER;
+static DBusConnection *control;  /* follows the watcher and sends notifications */
+static int wake_pipe[2] = { -1, -1 };
+static unsigned int item_serial;
+
+static BOOL load_dbus_functions(void)
+{
+    void *handle;
+
+    if (!(handle = dlopen( SONAME_LIBDBUS_1, RTLD_NOW )))
+        goto failed;
+
+#define DO_FUNC(f) if (!(p_##f = dlsym( handle, #f ))) goto failed
+    DBUS_FUNCS;
+#undef DO_FUNC
+    return TRUE;
+
+failed:
+    WARN( "failed to load DBUS support: %s\n", dlerror() );
+    return FALSE;
+}
+
+static DBusConnection *open_connection(void)
+{
+    DBusConnection *connection;
+    DBusError error;
+
+    p_dbus_error_init( &error );
+    if (!(connection = p_dbus_bus_get_private( DBUS_BUS_SESSION, &error )))
+    {
+        WARN( "failed to connect to the session bus: %s\n", debugstr_a(error.message) );
+        p_dbus_error_free( &error );
+        return NULL;
+    }
+    p_dbus_connection_set_exit_on_disconnect( connection, FALSE );
+    return connection;
+}
+
+static void close_connection( DBusConnection *connection )
+{
+    p_dbus_connection_close( connection );
+    p_dbus_connection_unref( connection );
+}
+
+static void wake_event_thread(void)
+{
+    while (write( wake_pipe[1], "", 1 ) == -1 && errno == EINTR);
+}
+
+static void free_item( struct sni_item *item )
+{
+    if (item->connection) close_connection( item->connection );
+    free( item->id );
+    free( item->title );
+    free( item->tooltip );
+    free( item->pixels );
+    free( item );
+}
+
+static struct sni_item *find_item( UINT64 hwnd )
+{
+    struct sni_item *item;
+
+    LIST_FOR_EACH_ENTRY( item, &items, struct sni_item, entry )
+        if (item->hwnd == hwnd) return item;
+    return NULL;
+}
+
+#define SNI_CHANGED_ICON    0x01
+#define SNI_CHANGED_TITLE   0x02
+#define SNI_CHANGED_TOOLTIP 0x04
+
+static BOOL set_item_data( struct sni_item *item, const struct sni_icon_params *params, unsigned int *changed )
+{
+    const char *id = param_ptr( params->id ), *title = param_ptr( params->title );
+    const char *tooltip = param_ptr( params->tooltip );
+    unsigned int i, count = 0;
+    UINT *pixels = NULL;
+
+    if (!id) id = "";
+    if (!title) title = "";
+    if (!tooltip) tooltip = "";
+
+    for (i = 0; i < SNI_MAX_SIZES && params->sizes[i]; i++) count += params->sizes[i] * params->sizes[i];
+    if (count && !(pixels = malloc( count * sizeof(*pixels) ))) return FALSE;
+    if (count) memcpy( pixels, param_ptr( params->pixels ), count * sizeof(*pixels) );
+
+    /* applications often set the same icon again when they only change the tip */
+    *changed = 0;
+    if (memcmp( item->sizes, params->sizes, sizeof(item->sizes) ) ||
+        (count && memcmp( item->pixels, pixels, count * sizeof(*pixels) )))
+        *changed |= SNI_CHANGED_ICON;
+    if (!item->title || strcmp( item->title, title )) *changed |= SNI_CHANGED_TITLE;
+    if (!item->tooltip || strcmp( item->tooltip, tooltip )) *changed |= SNI_CHANGED_TOOLTIP;
+
+    free( item->id );
+    free( item->title );
+    free( item->tooltip );
+    free( item->pixels );
+    item->id = strdup( id );
+    item->title = strdup( title );
+    item->tooltip = strdup( tooltip );
+    item->pixels = pixels;
+    memcpy( item->sizes, params->sizes, sizeof(item->sizes) );
+    return item->id && item->title && item->tooltip;
+}
+
+static void register_item( const struct sni_item *item )
+{
+    const char *name = item->name;
+    DBusMessage *msg;
+
+    if (!(msg = p_dbus_message_new_method_call( watcher_name, watcher_path, watcher_name,
+                                                "RegisterStatusNotifierItem" ))) return;
+    p_dbus_message_append_args( msg, DBUS_TYPE_STRING, &name, DBUS_TYPE_INVALID );
+    p_dbus_message_set_no_reply( msg, TRUE );
+    p_dbus_connection_send( item->connection, msg, NULL );
+    p_dbus_connection_flush( item->connection );
+    p_dbus_message_unref( msg );
+}
+
+static void send_item_signal( const struct sni_item *item, const char *name )
+{
+    DBusMessage *msg;
+
+    if (!(msg = p_dbus_message_new_signal( item_path, item_interface, name ))) return;
+    p_dbus_connection_send( item->connection, msg, NULL );
+    p_dbus_message_unref( msg );
+}
+
+static void append_string( DBusMessageIter *iter, const char *str )
+{
+    p_dbus_message_iter_append_basic( iter, DBUS_TYPE_STRING, &str );
+}
+
+static void append_pixmaps( DBusMessageIter *iter, const struct sni_item *item )
+{
+    DBusMessageIter array, image, bytes;
+    const UINT *pixels = item->pixels;
+    unsigned int i;
+
+    p_dbus_message_iter_open_container( iter, DBUS_TYPE_ARRAY, "(iiay)", &array );
+    for (i = 0; i < SNI_MAX_SIZES && item->sizes[i]; i++)
+    {
+        dbus_int32_t size = item->sizes[i];
+        const BYTE *data = (const BYTE *)pixels;
+
+        p_dbus_message_iter_open_container( &array, DBUS_TYPE_STRUCT, NULL, &image );
+        p_dbus_message_iter_append_basic( &image, DBUS_TYPE_INT32, &size );
+        p_dbus_message_iter_append_basic( &image, DBUS_TYPE_INT32, &size );
+        p_dbus_message_iter_open_container( &image, DBUS_TYPE_ARRAY, "y", &bytes );
+        p_dbus_message_iter_append_fixed_array( &bytes, DBUS_TYPE_BYTE, &data, size * size * 4 );
+        p_dbus_message_iter_close_container( &image, &bytes );
+        p_dbus_message_iter_close_container( &array, &image );
+        pixels += size * size;
+    }
+    p_dbus_message_iter_close_container( iter, &array );
+}
+
+static void append_tooltip( DBusMessageIter *iter, const struct sni_item *item )
+{
+    DBusMessageIter tooltip, pixmaps;
+
+    p_dbus_message_iter_open_container( iter, DBUS_TYPE_STRUCT, NULL, &tooltip );
+    append_string( &tooltip, "" );
+    p_dbus_message_iter_open_container( &tooltip, DBUS_TYPE_ARRAY, "(iiay)", &pixmaps );
+    p_dbus_message_iter_close_container( &tooltip, &pixmaps );
+    append_string( &tooltip, item->tooltip );
+    append_string( &tooltip, "" );
+    p_dbus_message_iter_close_container( iter, &tooltip );
+}
+
+static BOOL append_property( DBusMessageIter *iter, const struct sni_item *item, const char *name )
+{
+    DBusMessageIter variant;
+    dbus_int32_t window_id = 0;
+    dbus_bool_t is_menu = FALSE;
+    const char *str = NULL;
+
+    if (!strcmp( name, "Category" )) str = "ApplicationStatus";
+    else if (!strcmp( name, "Id" )) str = item->id;
+    else if (!strcmp( name, "Title" )) str = item->title;
+    else if (!strcmp( name, "Status" )) str = "Active";
+    else if (!strcmp( name, "IconName" ) || !strcmp( name, "OverlayIconName" ) ||
+             !strcmp( name, "AttentionIconName" )) str = "";
+
+    if (str)
+    {
+        p_dbus_message_iter_open_container( iter, DBUS_TYPE_VARIANT, "s", &variant );
+        append_string( &variant, str );
+    }
+    else if (!strcmp( name, "WindowId" ))
+    {
+        p_dbus_message_iter_open_container( iter, DBUS_TYPE_VARIANT, "i", &variant );
+        p_dbus_message_iter_append_basic( &variant, DBUS_TYPE_INT32, &window_id );
+    }
+    else if (!strcmp( name, "ItemIsMenu" ))
+    {
+        p_dbus_message_iter_open_container( iter, DBUS_TYPE_VARIANT, "b", &variant );
+        p_dbus_message_iter_append_basic( &variant, DBUS_TYPE_BOOLEAN, &is_menu );
+    }
+    else if (!strcmp( name, "IconPixmap" ))
+    {
+        p_dbus_message_iter_open_container( iter, DBUS_TYPE_VARIANT, "a(iiay)", &variant );
+        append_pixmaps( &variant, item );
+    }
+    else if (!strcmp( name, "ToolTip" ))
+    {
+        p_dbus_message_iter_open_container( iter, DBUS_TYPE_VARIANT, "(sa(iiay)ss)", &variant );
+        append_tooltip( &variant, item );
+    }
+    else return FALSE;  /* no Menu: hosts then call ContextMenu, and the application shows its own menu */
+
+    p_dbus_message_iter_close_container( iter, &variant );
+    return TRUE;
+}
+
+static DBusMessage *get_property( const struct sni_item *item, DBusMessage *msg )
+{
+    const char *interface, *name;
+    DBusMessageIter iter;
+    DBusMessage *reply;
+
+    if (!p_dbus_message_get_args( msg, NULL, DBUS_TYPE_STRING, &interface, DBUS_TYPE_STRING, &name,
+                                  DBUS_TYPE_INVALID ))
+        return p_dbus_message_new_error( msg, DBUS_ERROR_INVALID_ARGS, NULL );
+    if (!(reply = p_dbus_message_new_method_return( msg ))) return NULL;
+    p_dbus_message_iter_init_append( reply, &iter );
+    if (!strcmp( interface, item_interface ) && append_property( &iter, item, name )) return reply;
+    p_dbus_message_unref( reply );
+    return p_dbus_message_new_error( msg, DBUS_ERROR_UNKNOWN_PROPERTY, name );
+}
+
+static DBusMessage *get_all_properties( const struct sni_item *item, DBusMessage *msg )
+{
+    DBusMessageIter iter, array, entry;
+    const char *interface;
+    DBusMessage *reply;
+    unsigned int i;
+
+    if (!p_dbus_message_get_args( msg, NULL, DBUS_TYPE_STRING, &interface, DBUS_TYPE_INVALID ))
+        return p_dbus_message_new_error( msg, DBUS_ERROR_INVALID_ARGS, NULL );
+    if (!(reply = p_dbus_message_new_method_return( msg ))) return NULL;
+    p_dbus_message_iter_init_append( reply, &iter );
+    p_dbus_message_iter_open_container( &iter, DBUS_TYPE_ARRAY, "{sv}", &array );
+    for (i = 0; !strcmp( interface, item_interface ) && i < ARRAY_SIZE(property_names); i++)
+    {
+        p_dbus_message_iter_open_container( &array, DBUS_TYPE_DICT_ENTRY, NULL, &entry );
+        append_string( &entry, property_names[i] );
+        append_property( &entry, item, property_names[i] );
+        p_dbus_message_iter_close_container( &array, &entry );
+    }
+    p_dbus_message_iter_close_container( &iter, &array );
+    return reply;
+}
+
+/* answer a call from the host; returns TRUE when it is a click to pass on */
+static BOOL handle_item_message( const struct sni_item *item, DBusMessage *msg, struct sni_event_params *event )
+{
+    const char *path = p_dbus_message_get_path( msg );
+    DBusMessage *reply = NULL;
+    dbus_int32_t x = 0, y = 0;
+    BOOL ret = FALSE;
+    int type = -1;
+
+    if (p_dbus_message_get_type( msg ) != DBUS_MESSAGE_TYPE_METHOD_CALL) return FALSE;
+
+    TRACE( "%s %s.%s\n", item->name, debugstr_a(p_dbus_message_get_interface( msg )),
+           debugstr_a(p_dbus_message_get_member( msg )) );
+
+    if (!path || strcmp( path, item_path ))
+        reply = p_dbus_message_new_error( msg, DBUS_ERROR_UNKNOWN_OBJECT, path );
+    else if (p_dbus_message_is_method_call( msg, DBUS_INTERFACE_INTROSPECTABLE, "Introspect" ))
+    {
+        if ((reply = p_dbus_message_new_method_return( msg )))
+        {
+            const char *xml = introspection_xml;
+            p_dbus_message_append_args( reply, DBUS_TYPE_STRING, &xml, DBUS_TYPE_INVALID );
+        }
+    }
+    else if (p_dbus_message_is_method_call( msg, DBUS_INTERFACE_PROPERTIES, "Get" ))
+        reply = get_property( item, msg );
+    else if (p_dbus_message_is_method_call( msg, DBUS_INTERFACE_PROPERTIES, "GetAll" ))
+        reply = get_all_properties( item, msg );
+    else
+    {
+        if (p_dbus_message_is_method_call( msg, item_interface, "Activate" ))
+            type = SNI_EVENT_ACTIVATE;
+        else if (p_dbus_message_is_method_call( msg, item_interface, "SecondaryActivate" ))
+            type = SNI_EVENT_SECONDARY_ACTIVATE;
+        else if (p_dbus_message_is_method_call( msg, item_interface, "ContextMenu" ))
+            type = SNI_EVENT_CONTEXT_MENU;
+
+        if (type != -1)
+        {
+            p_dbus_message_get_args( msg, NULL, DBUS_TYPE_INT32, &x, DBUS_TYPE_INT32, &y, DBUS_TYPE_INVALID );
+            event->hwnd = item->hwnd;
+            event->type = type;
+            event->x = x;
+            event->y = y;
+            ret = TRUE;
+            reply = p_dbus_message_new_method_return( msg );
+        }
+        else if (p_dbus_message_is_method_call( msg, item_interface, "Scroll" ))
+            reply = p_dbus_message_new_method_return( msg );
+        else
+            reply = p_dbus_message_new_error( msg, DBUS_ERROR_UNKNOWN_METHOD, p_dbus_message_get_member( msg ) );
+    }
+
+    if (reply)
+    {
+        if (!p_dbus_message_get_no_reply( msg )) p_dbus_connection_send( item->connection, reply, NULL );
+        p_dbus_message_unref( reply );
+    }
+    return ret;
+}
+
+/* a new watcher, e.g. after the panel was restarted, does not know the items yet */
+static void handle_control_message( DBusMessage *msg )
+{
+    const char *name, *old_owner, *new_owner;
+    struct sni_item *item;
+
+    if (!p_dbus_message_is_signal( msg, DBUS_INTERFACE_DBUS, "NameOwnerChanged" )) return;
+    if (!p_dbus_message_get_args( msg, NULL, DBUS_TYPE_STRING, &name, DBUS_TYPE_STRING, &old_owner,
+                                  DBUS_TYPE_STRING, &new_owner, DBUS_TYPE_INVALID )) return;
+    if (strcmp( name, watcher_name ) || !new_owner[0]) return;
+
+    TRACE( "new watcher %s, registering the items again\n", debugstr_a(new_owner) );
+    LIST_FOR_EACH_ENTRY( item, &items, struct sni_item, entry ) register_item( item );
+}
+
+static NTSTATUS sni_init( void *args )
+{
+    DBusError error;
+    int i;
+
+    if (!load_dbus_functions()) return STATUS_NOT_SUPPORTED;
+    p_dbus_threads_init_default();
+    if (!(control = open_connection())) return STATUS_NOT_SUPPORTED;
+
+    p_dbus_error_init( &error );
+    if (!p_dbus_bus_name_has_owner( control, watcher_name, &error ))
+    {
+        TRACE( "no StatusNotifierWatcher on the session bus\n" );
+        p_dbus_error_free( &error );
+        close_connection( control );
+        control = NULL;
+        return STATUS_NOT_SUPPORTED;
+    }
+
+    if (pipe( wake_pipe ) == -1)
+    {
+        ERR( "failed to create a pipe: %s\n", strerror( errno ) );
+        close_connection( control );
+        control = NULL;
+        return STATUS_UNSUCCESSFUL;
+    }
+    for (i = 0; i < 2; i++)
+    {
+        fcntl( wake_pipe[i], F_SETFD, FD_CLOEXEC );
+        fcntl( wake_pipe[i], F_SETFL, O_NONBLOCK );
+    }
+
+    p_dbus_bus_add_match( control, "type='signal',sender='" DBUS_SERVICE_DBUS "',interface='" DBUS_INTERFACE_DBUS
+                          "',member='NameOwnerChanged',arg0='org.kde.StatusNotifierWatcher'", NULL );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS sni_add_item( void *args )
+{
+    const struct sni_icon_params *params = args;
+    struct sni_item *item;
+    unsigned int changed;
+    DBusError error;
+    int ret;
+
+    if (!(item = calloc( 1, sizeof(*item) ))) return STATUS_NO_MEMORY;
+    item->hwnd = params->hwnd;
+    if (!set_item_data( item, params, &changed ) || !(item->connection = open_connection()))
+    {
+        free_item( item );
+        return STATUS_UNSUCCESSFUL;
+    }
+
+    pthread_mutex_lock( &items_mutex );
+    snprintf( item->name, sizeof(item->name), "org.kde.StatusNotifierItem-%d-%u", getpid(), ++item_serial );
+    pthread_mutex_unlock( &items_mutex );
+
+    p_dbus_error_init( &error );
+    ret = p_dbus_bus_request_name( item->connection, item->name, DBUS_NAME_FLAG_DO_NOT_QUEUE, &error );
+    if (ret != DBUS_REQUEST_NAME_REPLY_PRIMARY_OWNER)
+    {
+        WARN( "failed to own %s: %d %s\n", item->name, ret, debugstr_a(error.message) );
+        p_dbus_error_free( &error );
+        free_item( item );
+        return STATUS_UNSUCCESSFUL;
+    }
+
+    TRACE( "hwnd %s name %s title %s\n", wine_dbgstr_longlong( params->hwnd ), item->name,
+           debugstr_a(item->title) );
+
+    pthread_mutex_lock( &items_mutex );
+    list_add_tail( &items, &item->entry );
+    register_item( item );
+    pthread_mutex_unlock( &items_mutex );
+    wake_event_thread();
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS sni_update_item( void *args )
+{
+    const struct sni_icon_params *params = args;
+    NTSTATUS status = STATUS_NOT_FOUND;
+    struct sni_item *item;
+    unsigned int changed;
+
+    pthread_mutex_lock( &items_mutex );
+    if ((item = find_item( params->hwnd )))
+    {
+        if (set_item_data( item, params, &changed ))
+        {
+            if (changed & SNI_CHANGED_ICON) send_item_signal( item, "NewIcon" );
+            if (changed & SNI_CHANGED_TITLE) send_item_signal( item, "NewTitle" );
+            if (changed & SNI_CHANGED_TOOLTIP) send_item_signal( item, "NewToolTip" );
+            p_dbus_connection_flush( item->connection );
+            status = STATUS_SUCCESS;
+        }
+        else status = STATUS_NO_MEMORY;
+    }
+    pthread_mutex_unlock( &items_mutex );
+    return status;
+}
+
+static NTSTATUS sni_remove_item( void *args )
+{
+    const struct sni_remove_params *params = args;
+    struct sni_item *item;
+
+    pthread_mutex_lock( &items_mutex );
+    if ((item = find_item( params->hwnd ))) list_remove( &item->entry );
+    pthread_mutex_unlock( &items_mutex );
+
+    if (!item) return STATUS_NOT_FOUND;
+    TRACE( "hwnd %s name %s\n", wine_dbgstr_longlong( params->hwnd ), item->name );
+    free_item( item );
+    wake_event_thread();
+    return STATUS_SUCCESS;
+}
+
+/* answer the host until it reports a click */
+static NTSTATUS sni_wait_event( void *args )
+{
+    struct sni_event_params *params = args;
+    struct pollfd fds[64];
+    struct sni_item *item;
+    unsigned int count;
+    DBusMessage *msg;
+    char buffer[16];
+
+    for (;;)
+    {
+        pthread_mutex_lock( &items_mutex );
+
+        if (!p_dbus_connection_get_is_connected( control ))
+        {
+            pthread_mutex_unlock( &items_mutex );
+            WARN( "lost the session bus\n" );
+            return STATUS_CONNECTION_DISCONNECTED;
+        }
+        p_dbus_connection_read_write( control, 0 );
+        while ((msg = p_dbus_connection_pop_message( control )))
+        {
+            handle_control_message( msg );
+            p_dbus_message_unref( msg );
+        }
+
+        LIST_FOR_EACH_ENTRY( item, &items, struct sni_item, entry )
+        {
+            p_dbus_connection_read_write( item->connection, 0 );
+            while ((msg = p_dbus_connection_pop_message( item->connection )))
+            {
+                BOOL event = handle_item_message( item, msg, params );
+
+                p_dbus_message_unref( msg );
+                if (!event) continue;
+                p_dbus_connection_flush( item->connection );
+                pthread_mutex_unlock( &items_mutex );
+                return STATUS_SUCCESS;
+            }
+            p_dbus_connection_flush( item->connection );
+        }
+
+        fds[0].fd = wake_pipe[0];
+        fds[0].events = POLLIN;
+        p_dbus_connection_get_unix_fd( control, &fds[1].fd );
+        fds[1].events = POLLIN;
+        count = 2;
+        LIST_FOR_EACH_ENTRY( item, &items, struct sni_item, entry )
+        {
+            if (count == ARRAY_SIZE(fds)) break;
+            if (!p_dbus_connection_get_is_connected( item->connection )) continue;
+            if (!p_dbus_connection_get_unix_fd( item->connection, &fds[count].fd )) continue;
+            fds[count++].events = POLLIN;
+        }
+
+        pthread_mutex_unlock( &items_mutex );
+
+        if (poll( fds, count, -1 ) == -1 && errno != EINTR)
+        {
+            ERR( "poll failed: %s\n", strerror( errno ) );
+            return STATUS_UNSUCCESSFUL;
+        }
+        if (fds[0].revents & POLLIN) while (read( wake_pipe[0], buffer, sizeof(buffer) ) > 0);
+    }
+}
+
+/* balloons are shown as desktop notifications */
+static NTSTATUS sni_notify( void *args )
+{
+    const struct sni_notify_params *params = args;
+    const char *app = param_ptr( params->app ), *title = param_ptr( params->title );
+    const char *text = param_ptr( params->text );
+    dbus_int32_t timeout = params->timeout;
+    DBusMessageIter iter, array;
+    dbus_uint32_t replaces = 0;
+    DBusMessage *msg;
+
+    if (!(msg = p_dbus_message_new_method_call( "org.freedesktop.Notifications", "/org/freedesktop/Notifications",
+                                                "org.freedesktop.Notifications", "Notify" )))
+        return STATUS_NO_MEMORY;
+
+    p_dbus_message_iter_init_append( msg, &iter );
+    append_string( &iter, app ? app : "" );
+    p_dbus_message_iter_append_basic( &iter, DBUS_TYPE_UINT32, &replaces );
+    append_string( &iter, "" );
+    append_string( &iter, title ? title : "" );
+    append_string( &iter, text ? text : "" );
+    p_dbus_message_iter_open_container( &iter, DBUS_TYPE_ARRAY, "s", &array );
+    p_dbus_message_iter_close_container( &iter, &array );
+    p_dbus_message_iter_open_container( &iter, DBUS_TYPE_ARRAY, "{sv}", &array );
+    p_dbus_message_iter_close_container( &iter, &array );
+    p_dbus_message_iter_append_basic( &iter, DBUS_TYPE_INT32, &timeout );
+    p_dbus_message_set_no_reply( msg, TRUE );
+
+    pthread_mutex_lock( &items_mutex );
+    p_dbus_connection_send( control, msg, NULL );
+    p_dbus_connection_flush( control );
+    pthread_mutex_unlock( &items_mutex );
+    p_dbus_message_unref( msg );
+    return STATUS_SUCCESS;
+}
+
+#else  /* SONAME_LIBDBUS_1 */
+
+static NTSTATUS sni_init( void *args )
+{
+    TRACE( "built without DBus support\n" );
+    return STATUS_NOT_SUPPORTED;
+}
+
+static NTSTATUS sni_add_item( void *args )
+{
+    return STATUS_NOT_SUPPORTED;
+}
+
+static NTSTATUS sni_update_item( void *args )
+{
+    return STATUS_NOT_SUPPORTED;
+}
+
+static NTSTATUS sni_remove_item( void *args )
+{
+    return STATUS_NOT_SUPPORTED;
+}
+
+static NTSTATUS sni_wait_event( void *args )
+{
+    return STATUS_NOT_SUPPORTED;
+}
+
+static NTSTATUS sni_notify( void *args )
+{
+    return STATUS_NOT_SUPPORTED;
+}
+
+#endif  /* SONAME_LIBDBUS_1 */
