+/* StatusNotifierItem hosts have no balloons; show a desktop notification instead */
+static void show_sni_balloon( struct icon *icon )
+{
+    struct sni_notify_params params;
+    char *app, *title, *text;
+
+    if (!icon->info_text[0]) return;
+
+    app = strdup_utf8( icon->tiptext );
+    title = strdup_utf8( icon->info_title );
+    text = strdup_utf8( icon->info_text );
+    params.app = (ULONG_PTR)app;
+    params.title = (ULONG_PTR)title;
+    params.text = (ULONG_PTR)text;
+    params.timeout = icon->info_timeout;
+    WINE_UNIX_CALL( unix_sni_notify, &params );
+    free( app );
+    free( title );
+    free( text );
+
+    icon->info_text[0] = 0;  /* clear text now that balloon has been shown */
+}
