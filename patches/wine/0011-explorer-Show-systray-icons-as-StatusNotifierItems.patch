+/* the file name of the application that owns the icon, which stays the same across runs */
+static char *get_icon_app_name( const struct icon *icon )
+{
+    WCHAR path[MAX_PATH], *name;
+    DWORD pid = 0, size = ARRAY_SIZE(path);
+    HANDLE process;
+
+    path[0] = 0;
+    GetWindowThreadProcessId( icon->owner, &pid );
+    if ((process = OpenProcess( PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid )))
+    {
+        if (!QueryFullProcessImageNameW( process, 0, path, &size )) path[0] = 0;
+        CloseHandle( process );
+    }
+    name = wcsrchr( path, '\\' );
+    return strdup_utf8( name ? name + 1 : path );
+}
