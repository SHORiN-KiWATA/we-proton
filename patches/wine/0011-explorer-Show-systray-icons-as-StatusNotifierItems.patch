 programs/explorer/sni.c       | 778 ++++++++++++++++++++++++++++++++++
 programs/explorer/systray.c   | 280 +++++++++++-
 programs/explorer/unixlib.h   |  79 ++++
 4 files changed, 1140 insertions(+), 1 deletion(-)
