+static void test_reflection_min_precision(void)
+{
+    static const D3D11_SIGNATURE_PARAMETER_DESC vs_in[] =
+    {
+        {"POSITION", 0, 0, D3D_NAME_UNDEFINED, D3D_REGISTER_COMPONENT_FLOAT32, 0xf, 0xf, 0, D3D_MIN_PRECISION_FLOAT_16},
+        {"TEXCOORD", 0, 1, D3D_NAME_UNDEFINED, D3D_REGISTER_COMPONENT_UINT32, 0x3, 0x3, 0, D3D_MIN_PRECISION_UINT_16},
+        {"TEXCOORD", 1, 2, D3D_NAME_UNDEFINED, D3D_REGISTER_COMPONENT_FLOAT32, 0x3, 0x3, 0, D3D_MIN_PRECISION_DEFAULT},
+        {"SV_InstanceID", 0, 3, D3D_NAME_INSTANCE_ID, D3D_REGISTER_COMPONENT_UINT32, 0x1, 0x1, 0, D3D_MIN_PRECISION_DEFAULT},
+    };
+    static const D3D11_SIGNATURE_PARAMETER_DESC vs_out[] =
+    {
+        {"SV_Position", 0, 0, D3D_NAME_POSITION, D3D_REGISTER_COMPONENT_FLOAT32, 0xf, 0x0, 0, D3D_MIN_PRECISION_DEFAULT},
+        {"TEXCOORD", 0, 1, D3D_NAME_UNDEFINED, D3D_REGISTER_COMPONENT_FLOAT32, 0x3, 0xc, 0, D3D_MIN_PRECISION_FLOAT_16},
+        {"TEXCOORD", 1, 2, D3D_NAME_UNDEFINED, D3D_REGISTER_COMPONENT_SINT32, 0x3, 0xc, 0, D3D_MIN_PRECISION_SINT_16},
+    };
+    static const D3D11_SIGNATURE_PARAMETER_DESC hs_in[] =
+    {
+        {"POSITION", 0, 0, D3D_NAME_UNDEFINED, D3D_REGISTER_COMPONENT_FLOAT32, 0xf, 0xf, 0, D3D_MIN_PRECISION_DEFAULT},
+    };
+    static const D3D11_SIGNATURE_PARAMETER_DESC hs_out[] =
+    {
+        {"POSITION", 0, 0, D3D_NAME_UNDEFINED, D3D_REGISTER_COMPONENT_FLOAT32, 0xf, 0x0, 0, D3D_MIN_PRECISION_DEFAULT},
+    };
+    static const D3D11_SIGNATURE_PARAMETER_DESC hs_patch[] =
+    {
+        {"SV_TessFactor", 0, 0, D3D_NAME_FINAL_TRI_EDGE_TESSFACTOR, D3D_REGISTER_COMPONENT_FLOAT32, 0x1, 0xe, 0, D3D_MIN_PRECISION_DEFAULT},
+        {"SV_TessFactor", 1, 1, D3D_NAME_FINAL_TRI_EDGE_TESSFACTOR, D3D_REGISTER_COMPONENT_FLOAT32, 0x1, 0xe, 0, D3D_MIN_PRECISION_DEFAULT},
+        {"SV_TessFactor", 2, 2, D3D_NAME_FINAL_TRI_EDGE_TESSFACTOR, D3D_REGISTER_COMPONENT_FLOAT32, 0x1, 0xe, 0, D3D_MIN_PRECISION_DEFAULT},
+        {"SV_InsideTessFactor", 0, 3, D3D_NAME_FINAL_TRI_INSIDE_TESSFACTOR, D3D_REGISTER_COMPONENT_FLOAT32, 0x1, 0xe, 0, D3D_MIN_PRECISION_DEFAULT},
