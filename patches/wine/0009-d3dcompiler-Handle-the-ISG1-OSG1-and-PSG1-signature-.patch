--- a/dlls/d3dcompiler_43/blob.c
+++ b/dlls/d3dcompiler_43/blob.c
@@ -169,23 +169,25 @@ static BOOL check_blob_part(DWORD tag, D3D_BLOB_PART part)
     switch(part)
     {
         case D3D_BLOB_INPUT_SIGNATURE_BLOB:
-            if (tag == TAG_ISGN) add = TRUE;
+            if (tag == TAG_ISGN || tag == TAG_ISG1) add = TRUE;
             break;
 
         case D3D_BLOB_OUTPUT_SIGNATURE_BLOB:
-            if (tag == TAG_OSGN || tag == TAG_OSG5) add = TRUE;
+            if (tag == TAG_OSGN || tag == TAG_OSG5 || tag == TAG_OSG1) add = TRUE;
             break;
 
         case D3D_BLOB_INPUT_AND_OUTPUT_SIGNATURE_BLOB:
-            if (tag == TAG_ISGN || tag == TAG_OSGN || tag == TAG_OSG5) add = TRUE;
+            if (tag == TAG_ISGN || tag == TAG_ISG1 || tag == TAG_OSGN || tag == TAG_OSG5 || tag == TAG_OSG1) add = TRUE;
             break;
 
         case D3D_BLOB_PATCH_CONSTANT_SIGNATURE_BLOB:
-            if (tag == TAG_PCSG) add = TRUE;
+            if (tag == TAG_PCSG || tag == TAG_PSG1) add = TRUE;
             break;
 
         case D3D_BLOB_ALL_SIGNATURE_BLOB:
-            if (tag == TAG_ISGN || tag == TAG_OSGN || tag == TAG_OSG5 || tag == TAG_PCSG) add = TRUE;
+            if (tag == TAG_ISGN || tag == TAG_ISG1 || tag == TAG_OSGN || tag == TAG_OSG5 || tag == TAG_OSG1
+                    || tag == TAG_PCSG || tag == TAG_PSG1)
+                add = TRUE;
             break;
 
         case D3D_BLOB_DEBUG_INFO:
