+#if D3D_COMPILER_VERSION >= 46
+static void check_signature_parameters(ID3D11ShaderReflection *ref11, unsigned int kind,
+        const D3D11_SIGNATURE_PARAMETER_DESC *expected, unsigned int count)
+{
+    D3D11_SIGNATURE_PARAMETER_DESC desc;
+    unsigned int i;
+    HRESULT hr;
+
+    for (i = 0; i < count; ++i)
+    {
+        winetest_push_context("%u", i);
+        memset(&desc, 0xcc, sizeof(desc));
+        if (kind == 0)
+            hr = ref11->lpVtbl->GetInputParameterDesc(ref11, i, &desc);
+        else if (kind == 1)
+            hr = ref11->lpVtbl->GetOutputParameterDesc(ref11, i, &desc);
+        else
+            hr = ref11->lpVtbl->GetPatchConstantParameterDesc(ref11, i, &desc);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+        ok(!strcmp(desc.SemanticName, expected[i].SemanticName), "Got unexpected SemanticName \"%s\".\n", desc.SemanticName);
+        ok(desc.SemanticIndex == expected[i].SemanticIndex, "Got unexpected SemanticIndex %u.\n", desc.SemanticIndex);
+        ok(desc.Register == expected[i].Register, "Got unexpected Register %u.\n", desc.Register);
+        ok(desc.SystemValueType == expected[i].SystemValueType, "Got unexpected SystemValueType %#x.\n", desc.SystemValueType);
+        ok(desc.ComponentType == expected[i].ComponentType, "Got unexpected ComponentType %#x.\n", desc.ComponentType);
+        ok(desc.Mask == expected[i].Mask, "Got unexpected Mask %#x.\n", desc.Mask);
+        ok(desc.ReadWriteMask == expected[i].ReadWriteMask, "Got unexpected ReadWriteMask %#x.\n", desc.ReadWriteMask);
+        ok(desc.Stream == expected[i].Stream, "Got unexpected Stream %u.\n", desc.Stream);
+        ok(desc.MinPrecision == expected[i].MinPrecision, "Got unexpected MinPrecision %#x.\n", desc.MinPrecision);
+        winetest_pop_context();
+    }
+}
