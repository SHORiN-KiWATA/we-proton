+static void test_get_blob_part_min_precision(void)
+{
+    static const struct
+    {
+        D3D_BLOB_PART part;
+        SIZE_T size;
+        unsigned int tag_count;
+        DWORD tags[3];
+    }
+    tests[] =
+    {
+        {D3D_BLOB_INPUT_SIGNATURE_BLOB, 96, 1, {TAG_ISG1}},
+        {D3D_BLOB_OUTPUT_SIGNATURE_BLOB, 96, 1, {TAG_OSG1}},
+        {D3D_BLOB_INPUT_AND_OUTPUT_SIGNATURE_BLOB, 160, 2, {TAG_ISG1, TAG_OSG1}},
+        {D3D_BLOB_PATCH_CONSTANT_SIGNATURE_BLOB, 256, 1, {TAG_PSG1}},
+        {D3D_BLOB_ALL_SIGNATURE_BLOB, 384, 3, {TAG_ISG1, TAG_OSG1, TAG_PSG1}},
+    };
+    const DWORD *dword;
+    unsigned int i, j;
+    ID3DBlob *blob;
+    ULONG refcount;
+    HRESULT hr;
+
+    for (i = 0; i < ARRAY_SIZE(tests); ++i)
+    {
+        winetest_push_context("%u", i);
+        hr = D3DGetBlobPart(test_blob_part_min_precision, test_blob_part_min_precision[6], tests[i].part, 0, &blob);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+        if (FAILED(hr))
+        {
+            winetest_pop_context();
+            continue;
+        }
+        ok(ID3D10Blob_GetBufferSize(blob) == tests[i].size, "Got unexpected size %Iu.\n", ID3D10Blob_GetBufferSize(blob));
+        dword = ID3D10Blob_GetBufferPointer(blob);
+        ok(dword[0] == TAG_DXBC, "Got unexpected magic %#lx.\n", dword[0]);
+        ok(dword[7] == tests[i].tag_count, "Got unexpected section count %lu.\n", dword[7]);
+        for (j = 0; j < tests[i].tag_count && j < dword[7]; ++j)
+            ok(dword[dword[8 + j] / sizeof(DWORD)] == tests[i].tags[j], "Got unexpected tag %#lx for section %u.\n",
+                    dword[dword[8 + j] / sizeof(DWORD)], j);
+        refcount = ID3D10Blob_Release(blob);
+        ok(!refcount, "ID3DBlob has %lu references left.\n", refcount);
+        winetest_pop_context();
+    }
+}
+#endif
