+++ b/dlls/win32u/main.c
@@ -1854,6 +1854,11 @@ DWORD SYSCALL_API NtUserGetWindowContextHelpId( HWND hwnd )
     SYSCALL_FUNC( NtUserGetWindowContextHelpId );
 }
 
+BOOL SYSCALL_API NtUserGetWindowBand( HWND hwnd, DWORD *band )
+{
+    SYSCALL_FUNC( NtUserGetWindowBand );
+}
+
 HDC SYSCALL_API NtUserGetWindowDC( HWND hwnd )
 {
