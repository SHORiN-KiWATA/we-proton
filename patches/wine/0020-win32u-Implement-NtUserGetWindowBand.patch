diff --git a/dlls/win32u/win32u.spec b/dlls/win32u/win32u.spec
index 5cb723a52ef..3ccad81a3f7 100644
--- a/dlls/win32u/win32u.spec
+++ b/dlls/win32u/win32u.spec
@@ -1113,7 +1113,7 @@
 @ stdcall -syscall NtUserGetUpdatedClipboardFormats(ptr long ptr)
 @ stub -syscall NtUserGetWOWClass
 @ stub -syscall NtUserGetWinStationInfo
-@ stub -syscall NtUserGetWindowBand
+@ stdcall -syscall NtUserGetWindowBand(long ptr)
 @ stub -syscall NtUserGetWindowCompositionAttribute
 @ stub -syscall NtUserGetWindowCompositionInfo
 @ stdcall -syscall NtUserGetWindowContextHelpId(long)
diff --git a/dlls/win32u/window.c b/dlls/win32u/window.c
index 264b3ff1217..cd2fea1b5f8 100644
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -7121,6 +7121,31 @@ BOOL WINAPI NtUserIsChildWindowDpiMessageEnabled( HWND hwnd )
     return FALSE;
 }
 
+/*****************************************************************
+ *           NtUserGetWindowBand (win32u.@)
+ *
+ * Windows keeps top-level windows in z-order bands; everything an
+ * application creates is in the desktop band, the only one Wine has.
+ */
+BOOL WINAPI NtUserGetWindowBand( HWND hwnd, DWORD *band )
+{
+    TRACE( "%p, %p\n", hwnd, band );
+
+    if (!is_window( hwnd ))
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_WINDOW_HANDLE );
+        return FALSE;
+    }
+    if (!band)
+    {
+        RtlSetLastWin32Error( ERROR_NOACCESS );
+        return FALSE;
+    }
+
+    *band = 1;  /* ZBID_DESKTOP */
+    return TRUE;
+}
+
 /*****************************************************************
  *           NtUserGetWindowDisplayAffinity (win32u.@)
  */
diff --git a/dlls/wow64win/user.c b/dlls/wow64win/user.c
index 8bb35d2d3a3..4c001d072b7 100644
--- a/dlls/wow64win/user.c
+++ b/dlls/wow64win/user.c
@@ -3235,6 +3235,14 @@ NTSTATUS WINAPI wow64_NtUserGetUpdatedClipboardFormats( UINT *args )
     return NtUserGetUpdatedClipboardFormats( formats, size, out_size );
 }
 
+NTSTATUS WINAPI wow64_NtUserGetWindowBand( UINT *args )
+{
+    HWND hwnd = get_handle( &args );
+    DWORD *band = get_ptr( &args );
+
+    return NtUserGetWindowBand( hwnd, band );
+}
+
 NTSTATUS WINAPI wow64_NtUserGetWindowContextHelpId( UINT *args )
 {
     HWND hwnd = get_handle( &args );
