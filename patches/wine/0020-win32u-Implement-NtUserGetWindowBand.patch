From 6e95a1719c105b8176dfc8d7e1b6cad911ce2a0b Mon Sep 17 00:00:00 2001
From: SHORiN-KIWATA <shorin@users.noreply.github.com>
Date: Sun, 11 Oct 2026 15:19:13 +0900
Subject: [PATCH] win32u: Implement NtUserGetWindowBand.

It was a syscall stub, so any program that asks for a window's z-order
band was terminated with an unimplemented function exception. Windows
keeps top-level windows in bands; everything an application creates is
in the desktop band (ZBID_DESKTOP), the only one Wine has, so report that
for any valid window. Invalid handles fail with ERROR_INVALID_WINDOW_HANDLE
and a missing output pointer with ERROR_NOACCESS, like
NtUserGetWindowDisplayAffinity. Also add the wow64 thunk and export
GetWindowBand from user32.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 dlls/user32/tests/win.c | 32 ++++++++++++++++++++++++++++++++
 dlls/user32/user32.spec |  2 +-
 dlls/win32u/main.c      |  5 +++++
 dlls/win32u/win32u.spec |  2 +-
 dlls/win32u/window.c    | 25 +++++++++++++++++++++++++
 dlls/wow64win/user.c    |  8 ++++++++
 include/ntuser.h        |  1 +
 7 files changed, 73 insertions(+), 2 deletions(-)

diff --git a/dlls/user32/tests/win.c b/dlls/user32/tests/win.c
index 9ec0654bb7d..d1c5cd59b84 100644
--- a/dlls/user32/tests/win.c
+++ b/dlls/user32/tests/win.c
@@ -57,6 +57,7 @@ static BOOL (WINAPI *pSetProcessDefaultLayout)( DWORD layout );
 static BOOL (WINAPI *pFlashWindow)( HWND hwnd, BOOL bInvert );
 static BOOL (WINAPI *pFlashWindowEx)( PFLASHWINFO pfwi );
 static BOOL (WINAPI *pMirrorRgn)(HWND hwnd, HRGN hrgn);
+static BOOL (WINAPI *pGetWindowBand)(HWND hwnd, DWORD *band);
 static BOOL (WINAPI *pGetWindowDisplayAffinity)(HWND hwnd, DWORD *affinity);
 static BOOL (WINAPI *pSetWindowDisplayAffinity)(HWND hwnd, DWORD affinity);
 static BOOL (WINAPI *pAdjustWindowRectExForDpi)(LPRECT,DWORD,BOOL,DWORD,UINT);
@@ -12574,6 +12575,35 @@ static void test_topmost(void)
     DestroyWindow(owner);
 }
 
+static void test_window_band( HWND win )
+{
+    DWORD band;
+    BOOL ret;
+
+    if (!pGetWindowBand)
+    {
+        win_skip("GetWindowBand missing\n");
+        return;
+    }
+
+    SetLastError(0xdeadbeef);
+    band = 0xdeadbeef;
+    ret = pGetWindowBand(NULL, &band);
+    ok(!ret, "GetWindowBand succeeded\n");
+    ok(GetLastError() == ERROR_INVALID_WINDOW_HANDLE, "Expected ERROR_INVALID_WINDOW_HANDLE, got %lu\n", GetLastError());
+    ok(band == 0xdeadbeef, "band changed to %#lx\n", band);
+
+    SetLastError(0xdeadbeef);
+    ret = pGetWindowBand((HWND)0xdeadbeef, &band);
+    ok(!ret, "GetWindowBand succeeded\n");
+    ok(GetLastError() == ERROR_INVALID_WINDOW_HANDLE, "Expected ERROR_INVALID_WINDOW_HANDLE, got %lu\n", GetLastError());
+
+    band = 0xdeadbeef;
+    ret = pGetWindowBand(win, &band);
+    ok(ret, "GetWindowBand failed with %lu\n", GetLastError());
+    ok(band == 1 /* ZBID_DESKTOP */, "Expected ZBID_DESKTOP, got %lu\n", band);
+}
+
 static void test_display_affinity( HWND win )
 {
     DWORD affinity;
@@ -14812,6 +14842,7 @@ START_TEST(win)
     pFlashWindow = (void *)GetProcAddress( user32, "FlashWindow" );
     pFlashWindowEx = (void *)GetProcAddress( user32, "FlashWindowEx" );
     pMirrorRgn = (void *)GetProcAddress( gdi32, "MirrorRgn" );
+    pGetWindowBand = (void *)GetProcAddress( user32, "GetWindowBand" );
     pGetWindowDisplayAffinity = (void *)GetProcAddress( user32, "GetWindowDisplayAffinity" );
     pSetWindowDisplayAffinity = (void *)GetProcAddress( user32, "SetWindowDisplayAffinity" );
     pAdjustWindowRectExForDpi = (void *)GetProcAddress( user32, "AdjustWindowRectExForDpi" );
@@ -14979,6 +15010,7 @@ START_TEST(win)
     test_deferwindowpos();
     test_LockWindowUpdate(hwndMain);
     test_desktop();
+    test_window_band(hwndMain);
     test_display_affinity(hwndMain);
     test_hide_window();
     test_minimize_window(hwndMain);
