From d3d91507f559ead249a3676aef3d2c89877310bb Mon Sep 17 00:00:00 2001
From: SHORiN-KIWATA <shorin@users.noreply.github.com>
Date: Mon, 12 Oct 2026 03:26:28 +0900
Subject: [PATCH] win32u: Leave notification icons to explorer.

explorer already shows them as StatusNotifierItems when a watcher owns the
name on the session bus. win32u's own StatusNotifierItem path takes the
icon's alpha from the colour plane whenever any pixel has a non-zero alpha,
so icons that cut their shape out with the AND mask come out with opaque
black where they should be transparent.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 dlls/win32u/systray.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/dlls/win32u/systray.c b/dlls/win32u/systray.c
index e5ae7e60be9..d3435e2409d 100644
--- a/dlls/win32u/systray.c
+++ b/dlls/win32u/systray.c
@@ -41,9 +41,10 @@ LRESULT system_tray_call( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam, voi
         user_driver->pCleanupIcons( hwnd );
         return 0;
     case WINE_SYSTRAY_NOTIFY_ICON_SNI:
-        return sni_notify_icon( hwnd, wparam, data );
+        /* explorer shows the icons as StatusNotifierItems itself */
+        return -1;
     case WINE_SYSTRAY_NOTIFY_BALLOON_SNI:
-        return sni_notify_balloon( data );
+        return FALSE;
     case WINE_SYSTRAY_DBUS_RUN:
         sni_run_loop();
         return 0;
