From cc461f853659a0a73398804e43cd870cd1c5790f Mon Sep 17 00:00:00 2001
From: shorinkiwata <fcl709@outlook.com>
Date: Thu, 8 Oct 2026 14:57:23 +0900
Subject: [PATCH] win32u: Draw layered child windows into their parent's
 surface.

Windows 8 and later allow WS_EX_LAYERED on child windows. UpdateLayeredWindow
created a layered surface for them like for toplevels, and winex11 backs a
layered surface with a window of its own: the child became a separate
override-redirect toplevel, placed at its parent-relative position as if that
were a screen position. Its contents showed up away from the parent, did not
follow it, and window managers treated it as another window.

Give layered child windows no surface of their own and draw the contents passed
to UpdateLayeredWindow into the surface they share with the parent, blending
per-pixel alpha over black. Since layered windows don't trigger repaints when
they move, repaint the part of the parent the child uncovered.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 dlls/win32u/window.c | 79 ++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 77 insertions(+), 2 deletions(-)

diff --git a/dlls/win32u/window.c b/dlls/win32u/window.c
index ca897cb..baa4996 100644
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -2626,6 +2626,62 @@ BOOL WINAPI NtUserSetLayeredWindowAttributes( HWND hwnd, COLORREF key, BYTE alph
     return ret;
 }
 
+/***********************************************************************
+ *           update_layered_child
+ *
+ * Draw the contents given to UpdateLayeredWindow for a layered child window
+ * (Windows 8 and later). Such a window has no surface of its own: the driver
+ * would turn one into a separate toplevel window, placed at the child's
+ * parent-relative position as if it were a screen position. Draw into the
+ * surface the child shares with its parent instead. Per-pixel alpha is blended
+ * over black, like the contents of a new layered surface.
+ */
+static BOOL update_layered_child( HWND hwnd, const RECT *window_rect, HDC hdc_src, const POINT *pts_src,
+                                  COLORREF key, const BLENDFUNCTION *blend, DWORD flags, const RECT *dirty )
+{
+    struct window_surface *surface;
+    RECT rect = *window_rect, src_rect;
+    int width, height;
+    BOOL ret;
+    HDC hdc;
+
+    if (!hdc_src) return TRUE;
+
+    OffsetRect( &rect, -rect.left, -rect.top );
+    if (dirty) intersect_rect( &rect, &rect, dirty );
+    if (IsRectEmpty( &rect )) return TRUE;
+    width = rect.right - rect.left;
+    height = rect.bottom - rect.top;
+
+    src_rect = rect;
+    if (pts_src) OffsetRect( &src_rect, pts_src->x, pts_src->y );
+    NtGdiTransformPoints( hdc_src, (POINT *)&src_rect, (POINT *)&src_rect, 2, NtGdiDPtoLP );
+
+    if (!(hdc = NtUserGetDCEx( hwnd, 0, DCX_CACHE | DCX_WINDOW | DCX_CLIPSIBLINGS | DCX_CLIPCHILDREN )))
+        return FALSE;
+    if ((flags & ULW_ALPHA) && blend)
+    {
+        NtGdiPatBlt( hdc, rect.left, rect.top, width, height, BLACKNESS );
+        ret = NtGdiAlphaBlend( hdc, rect.left, rect.top, width, height, hdc_src, src_rect.left, src_rect.top,
+                               src_rect.right - src_rect.left, src_rect.bottom - src_rect.top,
+                               *(DWORD *)blend, 0 );
+    }
+    else if (flags & ULW_COLORKEY)
+        ret = NtGdiTransparentBlt( hdc, rect.left, rect.top, width, height, hdc_src, src_rect.left, src_rect.top,
+                                   src_rect.right - src_rect.left, src_rect.bottom - src_rect.top, key );
+    else
+        ret = NtGdiBitBlt( hdc, rect.left, rect.top, width, height, hdc_src, src_rect.left, src_rect.top,
+                           SRCCOPY, 0, 0 );
+    NtUserReleaseDC( hwnd, hdc );
+
+    if ((surface = window_surface_get( NtUserGetAncestor( hwnd, GA_ROOT ) )))
+    {
+        window_surface_flush( surface );
+        window_surface_release( surface );
+    }
+    return ret;
+}
+
 /*****************************************************************************
  *           UpdateLayeredWindow (win32u.@)
  */
@@ -2635,9 +2691,11 @@ BOOL WINAPI NtUserUpdateLayeredWindow( HWND hwnd, HDC hdc_dst, const POINT *pts_
 {
     DWORD swp_flags = SWP_NOSIZE | SWP_NOMOVE | SWP_NOZORDER | SWP_NOACTIVATE | SWP_NOREDRAW;
     BYTE source_alpha = blend ? blend->SourceConstantAlpha : 0xff;
+    HWND parent = NtUserGetAncestor( hwnd, GA_PARENT );
+    BOOL is_child = parent && parent != get_desktop_window();
     struct window_rects new_rects;
     struct window_surface *surface;
-    RECT surface_rect;
+    RECT surface_rect, old_rect;
     SIZE offset;
     BOOL ret = FALSE;
 
@@ -2650,6 +2708,7 @@ BOOL WINAPI NtUserUpdateLayeredWindow( HWND hwnd, HDC hdc_dst, const POINT *pts_
     }
 
     get_window_rects( hwnd, COORDS_PARENT, &new_rects, get_thread_dpi() );
+    old_rect = new_rects.window;
 
     if (pts_dst)
     {
@@ -2685,8 +2744,24 @@ BOOL WINAPI NtUserUpdateLayeredWindow( HWND hwnd, HDC hdc_dst, const POINT *pts_
 
     TRACE( "window %p new_rects %s\n", hwnd, debugstr_window_rects( &new_rects ) );
 
-    surface = get_window_surface( hwnd, swp_flags, TRUE, &new_rects, &surface_rect );
+    surface = get_window_surface( hwnd, swp_flags, !is_child, &new_rects, &surface_rect );
     apply_window_pos( hwnd, 0, swp_flags, surface, &new_rects, NULL );
+    if (is_child)
+    {
+        if (surface) window_surface_release( surface );
+        /* layered windows don't trigger repaints when they move, repaint what the child uncovered */
+        if (!EqualRect( &old_rect, &new_rects.window ))
+        {
+            HRGN rgn = NtGdiCreateRectRgn( old_rect.left, old_rect.top, old_rect.right, old_rect.bottom );
+            HRGN new_rgn = NtGdiCreateRectRgn( new_rects.window.left, new_rects.window.top,
+                                               new_rects.window.right, new_rects.window.bottom );
+            NtGdiCombineRgn( rgn, rgn, new_rgn, RGN_DIFF );
+            NtUserRedrawWindow( parent, NULL, rgn, RDW_INVALIDATE | RDW_ERASE | RDW_ALLCHILDREN );
+            NtGdiDeleteObjectApp( new_rgn );
+            NtGdiDeleteObjectApp( rgn );
+        }
+        return update_layered_child( hwnd, &new_rects.window, hdc_src, pts_src, key, blend, flags, dirty );
+    }
     if (!surface) return FALSE;
 
     if (!hdc_src || surface == &dummy_surface)
-- 
2.56.0

