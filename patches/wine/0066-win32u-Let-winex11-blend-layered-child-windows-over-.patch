+struct layered_child_info
+{
+    HWND hwnd;      /* the layered child window */
+    RECT rect;      /* its rectangle in the client area of the window that was asked about */
+    SIZE size;      /* size of its image */
+    UINT serial;    /* changes with its image */
+    BYTE alpha;     /* opacity of the window as a whole */
+};
